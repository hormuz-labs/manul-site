---
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  eyebrow: string
}

const { title, description, eyebrow } = Astro.props
const canonical = new URL(Astro.url.pathname, 'https://manul.si')
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Manul</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ece6da" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={canonical} />
</head>
<body>
  <header class="top wrap">
    <a class="brand" href="/" aria-label="Manul home"><img src="/icon-56.png" width="28" height="28" alt="" /><span class="slate">Manul</span></a>
    <nav aria-label="Legal pages">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="https://github.com/hormuz-labs/manul">GitHub ↗</a>
    </nav>
  </header>

  <main class="wrap">
    <header class="title">
      <p class="label"><b>■</b> {eyebrow}</p>
      <h1 class="slate">{title}</h1>
      <p class="effective">Effective October 11, 2026</p>
    </header>
    <article>
      <slot />
    </article>
  </main>

  <footer class="wrap label">
    <span>© Hormuz Labs · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    <a href="/">Back to Manul</a>
  </footer>

  <style>
    .top { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
    .brand img { border-radius: 6px; }
    .brand .slate { font-size: 30px; line-height: 1; letter-spacing: .01em; }
    nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px 22px; }
    nav a { color: var(--ink-2); font: 500 14px/1 var(--mono); text-decoration: none; }
    nav a:hover { color: var(--red-ink); }

    main { padding-block: 72px 110px; }
    .title { max-width: 900px; padding-bottom: 52px; border-bottom: 2px solid var(--ink); }
    .title .label { margin: 0 0 24px; }
    h1 { margin: 0; max-width: 850px; color: var(--red); font-size: clamp(68px, 10vw, 132px); }
    .effective { margin: 26px 0 0; color: var(--ink-3); font: 500 13px/1.5 var(--mono); }
    article { max-width: 820px; padding-top: 52px; }
    article :global(.intro) { margin: 0 0 56px; color: var(--ink-2); font-size: clamp(21px, 2.2vw, 28px); line-height: 1.42; }
    article :global(section) { margin-top: 48px; }
    article :global(h2) { margin: 0 0 16px; font-size: clamp(30px, 4vw, 44px); font-variation-settings: 'wdth' 82; line-height: 1; }
    article :global(h3) { margin: 28px 0 8px; font-size: 20px; line-height: 1.25; }
    article :global(p), article :global(li) { color: var(--ink-2); }
    article :global(p) { margin: 0 0 16px; }
    article :global(ul) { margin: 14px 0 20px; padding-left: 24px; }
    article :global(li) { margin: 8px 0; padding-left: 4px; }
    article :global(a) { color: var(--ink); text-decoration-color: var(--red-ink); text-underline-offset: 3px; }
    article :global(a:hover) { color: var(--red-ink); }
    article :global(strong) { color: var(--ink); }

    footer { display: flex; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; padding-block: 26px 80px; border-top: 1px solid var(--paper-3); text-transform: none; letter-spacing: .02em; line-height: 1.6; }
    footer a { color: var(--ink-2); text-underline-offset: 3px; }
    footer a:hover { color: var(--red-ink); }

    @media (max-width: 640px) {
      .top { align-items: flex-start; padding-block: 20px; }
      nav { gap: 12px; }
      nav a:last-child { display: none; }
      main { padding-block: 46px 80px; }
      .title { padding-bottom: 38px; }
      article { padding-top: 38px; }
      article :global(.intro) { margin-bottom: 44px; }
    }
  </style>
</body>
</html>
