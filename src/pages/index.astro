---
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/global.css'
import Demo from '../components/Demo.astro'
import release from '../release.json'

// the latest release; .github/workflows/release.yml refreshes src/release.json when Manul ships
const version = release.version
const dl = (f: string) => `https://github.com/hormuz-labs/manul/releases/download/v${version}/${f}`
const agentPrompt = 'Install Manul from https://github.com/hormuz-labs/manul. On macOS run `brew install hormuz-labs/tap/manul`. On Linux, add the apt repository at https://apt.manul.si (instructions on that page) and `sudo apt install manul`, or download the .deb or AppImage for this machine from the latest GitHub release. Then open Manul.'
const brew = 'brew install hormuz-labs/tap/manul'
const title = 'Manul: the AI video editor you talk to. Free for Mac and Linux'
const description = 'A video editor you talk to. Drop in footage, say what you want, circle what’s wrong. Manul edits on your own computer and shows you a before / after of every change. Free and open source, for macOS and Linux: an alternative to CapCut, Premiere Pro, Descript and HyperFrames.'
const gh = 'https://github.com/hormuz-labs/manul'
const faqs = [
  { q: 'Is it really free?', a: `Yes. Manul is open source under the GPL-3.0. You pay your model provider directly for what the agent uses, usually cents per edit, and Manul shows the running cost as you go.` },
  { q: 'Does my video get uploaded anywhere?', a: `No. Cutting, rendering and transcription happen on your computer. The model only receives text (your notes, the transcript) and, when it needs to look, a few still frames.` },
  { q: 'Which AI does it use?', a: `Your pick, per project: Claude, Gemini or GPT. Add a key in Settings. A single Manul key that covers every model is coming.` },
  { q: 'Do I need to know video editing?', a: `No. If you can describe what you want to a person, you can direct Manul. If you do know editing, you’ll get there faster: it understands “J-cut”, “punch in” and “duck the music”.` },
  { q: 'Does Manul generate video?', a: `Not yet, and it’s next. Generated shots are on the roadmap: b-roll on the fly, extending a frame to a new aspect ratio, and filling in a spot you box. They go only where you ask, through the video model you choose, and each one is labelled as generated. Everything else Manul does works on the footage you shot.` },
  { q: 'What can’t it do yet?', a: `Generated shots, multi-camera sync, handing the cut to Premiere, Resolve or Final Cut, and Windows. All are on the <a href="${gh}/blob/main/ROADMAP.md">roadmap</a>, in the open.` },
  { q: 'How is it different from CapCut, Descript or HyperFrames?', a: `CapCut, Premiere Pro, Final Cut Pro and DaVinci Resolve hand you a timeline to operate. Descript lets you edit by editing the transcript. HyperFrames and Remotion turn video into code that an agent writes. Manul is a desktop app where you give notes in plain words, point at the frame, and review each change as a before and after, without code or a timeline.` },
  { q: 'Who makes it?', a: `Hormuz Labs, in the open. Issues, ideas and pull requests are welcome on <a href="${gh}">GitHub</a>.` },
]
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ece6da" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://manul.si/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manul.si/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://manul.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Manul', applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Linux', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: 'https://manul.si/',
    downloadUrl: `${gh}/releases/latest`, softwareVersion: version, license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Manul: you direct, it edits',
    description: 'An 88-second film about Manul, the video editor you talk to: drop in footage, say what you want, point at the frame, keep or send back each edit.',
    thumbnailUrl: 'https://manul.si/film/poster.jpg', contentUrl: 'https://manul.si/film/manul.mp4', uploadDate: '2026-10-07', duration: 'PT1M28S',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  })} />
</head>
<body>
  <!-- a running timecode: the page is a reel, scrolling plays it -->
  <div class="bar" id="bar">
    <div class="wrap">
      <a class="brand" href="#" aria-label="Back to top"><span class="slate">Manul</span></a>
      <span class="tc mono" aria-hidden="true"><i></i><span id="tc">00:00:00:00</span></span>
      <a href="#get" class="btn sm">Get Manul</a>
    </div>
  </div>

  <header class="top wrap">
    <a class="brand" href="/" aria-label="Manul home"><img src="/icon-56.png" width="28" height="28" alt="" /><span class="slate">Manul</span></a>
    <p class="label meta">v<span data-version>{version}</span> · macOS &amp; Linux · free, GPL-3.0</p>
    <nav>
      <a href="#notes">Notes</a>
      <a href="#get">Install</a>
      <a href={gh}>GitHub ↗</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <h1 class="slate">
        Give notes.<br />Get <span class="ringed">cuts.<svg viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M150 14C96 0 22 8 9 46c-11 34 58 50 114 47 56-3 76-26 70-52-5-20-40-31-82-28"/></svg></span>
      </h1>
      <div class="pitch">
        <p class="lede">Manul is a video editor you talk to. Drop in your footage, say what you want, circle what’s wrong on the frame. It makes the edit on your own computer and shows you before and after. You never touch a timeline.</p>
        <div class="cta">
          <div class="cta-row">
            <a href="#get" class="btn" data-os-cta>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>
              <span data-os-label>Get Manul, free</span>
            </a>
            <button class="film-open" type="button" data-film><i aria-hidden="true"></i>Watch the film <span class="mono">1:28</span></button>
          </div>
          <button class="brew mono" data-copy={brew} aria-label="Copy the Homebrew install command"><span>$ {brew}</span><em>copy</em></button>
        </div>
        <p class="trust label">No account · nothing uploaded · open source</p>
        <p class="phone-only label">A desktop app for macOS and Linux. Open this page on your computer to install.</p>
      </div>
    </section>

    <section class="stage wrap" aria-label="Try Manul">
      <div class="marks above" aria-hidden="true">
        <p class="mark m1"><span><b>1</b> give it a note</span>
          <svg viewBox="0 0 120 70"><path pathLength="1" d="M100 6C70 10 48 26 44 60"/><path pathLength="1" d="M33 48l11 13 10-14"/></svg></p>
      </div>
      <p class="mark phone" aria-hidden="true"><b>1</b> tap a note under the video. Every edit is real.</p>
      <Demo />
      <div class="marks below" aria-hidden="true">
        <p class="mark m2"><svg viewBox="0 0 120 70"><path pathLength="1" d="M8 62C44 60 66 42 72 8"/><path pathLength="1" d="M60 18l12-11 8 14"/></svg>
          <span><b>2</b> drag across the frame to compare,<br />then keep it or send it back</span></p>
        <p class="credit label">Clip: Timofey the Pallas’s cat, Moscow Zoo, CC BY 4.0.<br />Each “after” was rendered by the same engine Manul drives.</p>
      </div>
    </section>

    <section class="notes" id="notes">
      <div class="wrap">
        <div class="head">
          <p class="label"><b>■</b> The notes</p>
          <h2 class="slate">Say it like there’s an editor in the room.</h2>
          <p class="aside">Every word you recorded is transcribed with its timing, and every box you draw is pinned to a spot and a moment. So a note lands exactly where you meant it.</p>
        </div>
        <div class="edl" role="table" aria-label="Notes and what Manul did with them">
          <div class="row th" role="row"><span role="columnheader">#</span><span role="columnheader">Your note</span><span role="columnheader">Where</span><span role="columnheader">What Manul did</span></div>
          <div class="row" role="row">
            <span class="n mono" role="cell">001</span>
            <q role="cell">cut <s>the ums</s>, and the bit where I lose my train of thought</q>
            <span class="at mono" role="cell">02:31 → 02:12</span>
            <span class="did" role="cell">Cut on the word, not near it. Nineteen seconds gone, no jump in the audio.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">002</span>
            <q role="cell"><i class="boxed">box</i> blur this <span class="circled">number plate</span></q>
            <span class="at mono" role="cell">00:18 · box</span>
            <span class="did" role="cell">Blurred only what’s inside your box, and followed it while the car moved.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">003</span>
            <q role="cell">put my name on screen when I introduce myself</q>
            <span class="at mono" role="cell">00:06 “I’m”</span>
            <span class="did" role="cell">A lower third in real type, in on the word. Drag it somewhere else after if you like.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">004</span>
            <q role="cell">quiet music under the whole thing</q>
            <span class="at mono" role="cell">00:00 → end</span>
            <span class="did" role="cell">Looped to the length of the film and dipped under every sentence. You hear the mix before anything renders.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">005</span>
            <q role="cell">now a vertical one for Shorts, captions burned in</q>
            <span class="at mono" role="cell">9:16</span>
            <span class="did" role="cell">Same film, reframed on whoever’s talking, with captions timed to the word.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="rules">
      <div class="wrap">
        <p class="label"><b>■</b> House rules</p>
        <h2 class="slate">Four things it won’t do.</h2>
        <ol>
          <li><span class="n mono">1</span><h3 class="slate"><s>Swap your shots for fakes</s></h3><p>It cuts, crops and grades the footage you shot. Titles and captions are real type. Generated shots, when they come, go only where you ask, labelled as generated.</p></li>
          <li><span class="n mono">2</span><h3 class="slate"><s>Overwrite your work</s></h3><p>Every edit arrives as a new version. Scrub before and after, then keep it or send it back. Old versions stay one click away.</p></li>
          <li><span class="n mono">3</span><h3 class="slate"><s>Upload your footage</s></h3><p>Cutting, rendering and transcription run on your computer. The model you bring a key for sees text and the odd still frame.</p></li>
          <li><span class="n mono">4</span><h3 class="slate"><s>Hand you a timeline</s></h3><p>Point at the frame, drag across a sentence, click the wrong word in a title. That’s the whole interface.</p></li>
        </ol>
      </div>
    </section>

    <section class="fits wrap">
      <div class="head">
        <p class="label"><b>■</b> Where it fits</p>
        <h2 class="slate">Not a timeline.<br />Not a slot machine.<br />Not code.</h2>
      </div>
      <div class="cmp" role="table" aria-label="Manul compared with timeline editors, code-to-video tools and AI video generators">
        <div class="row th" role="row"><span role="columnheader"></span><span role="columnheader">Timeline editors<small>Premiere Pro, Final Cut Pro, DaVinci Resolve, CapCut</small></span><span role="columnheader">Video as code<small>HyperFrames, Remotion</small></span><span role="columnheader">AI generators<small>Runway, Sora, Veo</small></span><span role="columnheader" class="us">Manul<small>agentic editor</small></span></div>
        <div class="row" role="row"><span role="rowheader">You</span><span role="cell" data-h="Timeline editors">operate it, cut by cut</span><span role="cell" data-h="Video as code">describe it; an agent writes HTML</span><span role="cell" data-h="AI generators">prompt, hope, re-roll</span><span role="cell" data-h="Manul" class="us">say it, point at it</span></div>
        <div class="row" role="row"><span role="rowheader">You look at</span><span role="cell" data-h="Timeline editors">a timeline</span><span role="cell" data-h="Video as code">a terminal and code</span><span role="cell" data-h="AI generators">a prompt box</span><span role="cell" data-h="Manul" class="us">your film, before and after</span></div>
        <div class="row" role="row"><span role="rowheader">Your footage</span><span role="cell" data-h="Timeline editors">yours</span><span role="cell" data-h="Video as code">yours, plus coded layers</span><span role="cell" data-h="AI generators">swapped for generated frames</span><span role="cell" data-h="Manul" class="us">yours, untouched</span></div>
        <div class="row" role="row"><span role="rowheader">Generated shots</span><span role="cell" data-h="Timeline editors">some, built in</span><span role="cell" data-h="Video as code">no</span><span role="cell" data-h="AI generators">the whole film</span><span role="cell" class="us" data-h="Manul">only where you ask (soon)</span></div>
        <div class="row" role="row"><span role="rowheader">Runs on</span><span role="cell" data-h="Timeline editors">your computer</span><span role="cell" data-h="Video as code">your computer</span><span role="cell" data-h="AI generators">their cloud</span><span role="cell" data-h="Manul" class="us">your computer</span></div>
        <div class="row" role="row"><span role="rowheader">Undo</span><span role="cell" data-h="Timeline editors">Ctrl-Z, until it isn’t</span><span role="cell" data-h="Video as code">git, if you use it</span><span role="cell" data-h="AI generators">start over</span><span role="cell" data-h="Manul" class="us">every version, kept</span></div>
        <div class="row" role="row"><span role="rowheader">Costs</span><span role="cell" data-h="Timeline editors">a subscription, mostly</span><span role="cell" data-h="Video as code">free, plus your agent</span><span role="cell" data-h="AI generators">credits</span><span role="cell" data-h="Manul" class="us">free, plus any model key</span></div>
      </div>
    </section>

    <section class="next wrap" id="next">
      <div class="head">
        <p class="label"><b>■</b> Coming next</p>
        <h2 class="slate">The next reel.</h2>
        <p class="aside">Generated shots, for the moments your camera missed. Your footage stays the film; generation fills the gaps you point at, through the model you pick.</p>
      </div>
      <ol class="reel">
        <li><span class="tag mono">soon</span><h3 class="slate">B-roll on the fly</h3><p>Say <q>cut to the city at night here</q>. Manul generates a few takes; you pick one and it lands on that sentence.</p></li>
        <li><span class="tag mono">soon</span><h3 class="slate">Extend the frame</h3><p>Turn a 16:9 shot into a 9:16 Short without cropping anyone out. The new edges are filled to match the shot.</p></li>
        <li><span class="tag mono">soon</span><h3 class="slate">Complete the shot</h3><p>Box a spot and say what belongs there. Only that box, only for that moment, is generated.</p></li>
        <li><span class="tag mono">later</span><h3 class="slate">Hand off the cut</h3><p>Open Manul’s edit in Premiere Pro, DaVinci Resolve or Final Cut Pro, and publish to YouTube.</p></li>
      </ol>
      <p class="alt">The whole <a href={`${gh}/blob/main/ROADMAP.md`}>roadmap</a> is public, and open to ideas.</p>
    </section>

    <section class="get" id="get">
      <div class="wrap">
        <div class="get-top">
          <div class="head">
            <p class="label"><b>■</b> Install · v<span data-version>{version}</span></p>
            <h2 class="slate">Get it.</h2>
            <p class="aside">Free and open source, for macOS 12+ and Debian or Ubuntu.</p>
          </div>
          <ol class="first">
            <li><span class="mono">01</span><span>Open Manul and drop in a video.</span></li>
            <li><span class="mono">02</span><span>Paste a Claude, Gemini or OpenAI key. It stays in your system’s keychain.</span></li>
            <li><span class="mono">03</span><span>Give it your first note. Try <q>cut the silences</q>.</span></li>
          </ol>
        </div>

        <div class="tabs" role="tablist" aria-label="Choose your system">
          <button role="tab" id="t-mac" aria-controls="p-mac" aria-selected="true" data-tab="mac">macOS</button>
          <button role="tab" id="t-linux" aria-controls="p-linux" aria-selected="false" data-tab="linux">Linux</button>
          <button role="tab" id="t-agent" aria-controls="p-agent" aria-selected="false" data-tab="agent">Ask your agent</button>
        </div>

        <div class="panel" role="tabpanel" id="p-mac" aria-labelledby="t-mac">
          <p class="how">One line in Terminal. Updates install themselves.</p>
          <div class="cmd"><code>{brew}</code><button class="copy" data-copy={brew}>Copy</button></div>
          <p class="alt">No Homebrew? Download the app for{' '}<a href={dl(`Manul-${version}-arm64.dmg`)} data-file="Manul-{v}-arm64.dmg">Apple silicon</a> or{' '}<a href={dl(`Manul-${version}-x64.dmg`)} data-file="Manul-{v}-x64.dmg">Intel</a>.
            Until Apple notarization is done, open it the first time with right-click → Open.</p>
        </div>
        <div class="panel" role="tabpanel" id="p-linux" aria-labelledby="t-linux" hidden>
          <p class="how">Debian and Ubuntu: add the signed repository once, and apt keeps Manul up to date.</p>
          <div class="cmd multi"><code>curl -fsSL https://apt.manul.si/manul.gpg | sudo gpg --dearmor -o /usr/share/keyrings/manul.gpg
echo "deb [signed-by=/usr/share/keyrings/manul.gpg] https://apt.manul.si stable main" | sudo tee /etc/apt/sources.list.d/manul.list
sudo apt update && sudo apt install manul</code><button class="copy" data-copy-from="prev">Copy</button></div>
          <p class="alt">Or download:
            <a href={dl(`manul_${version}_amd64.deb`)} data-file="manul_{v}_amd64.deb">.deb x64</a> ·
            <a href={dl(`manul_${version}_arm64.deb`)} data-file="manul_{v}_arm64.deb">.deb ARM</a> ·
            <a href={dl(`manul_${version}_x86_64.AppImage`)} data-file="manul_{v}_x86_64.AppImage">AppImage x64</a> ·
            <a href={dl(`manul_${version}_arm64.AppImage`)} data-file="manul_{v}_arm64.AppImage">AppImage ARM</a></p>
        </div>
        <div class="panel" role="tabpanel" id="p-agent" aria-labelledby="t-agent" hidden>
          <p class="how">Using Claude Code, Cursor or Codex? Paste this and let it do the install.</p>
          <div class="cmd multi prose"><code>{agentPrompt}</code><button class="copy" data-copy={agentPrompt}>Copy</button></div>
        </div>
        <p class="alt windows">Windows is on the <a href={`${gh}/blob/main/ROADMAP.md`}>roadmap</a>.</p>
      </div>
    </section>

    <section class="cat wrap">
      <figure>
        <video id="cat" src="/timofey.mp4" poster="/timofey.webp" width="960" height="720" muted loop playsinline preload="none" aria-label="Timofey, a Pallas's cat, sitting in a doorway and staring flatly at the camera"><track kind="captions" src="/captions/silent.vtt" srclang="en" label="No sound" /></video>
        <figcaption class="label">Timofey. Unimpressed.</figcaption>
      </figure>
      <div>
        <p class="label"><b>■</b> Why a cat</p>
        <h2 class="slate">Named after the manul.</h2>
        <p>The manul, or Pallas’s cat, lives alone on the cold steppe of Central Asia. It doesn’t chase; it waits, then moves once, exactly. And it looks at everything with the same flat, faintly disappointed stare.</p>
        <p>That’s the editor we wanted in the room: patient, hard to impress, and precise when it counts.</p>
      </div>
    </section>

    <section class="faq" id="faq">
      <div class="wrap">
        <div class="head"><p class="label"><b>■</b> Questions</p></div>
        <div class="qs">
          {faqs.map(f => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
        </div>
      </div>
    </section>

    <section class="wrap-up wrap">
      <h2 class="slate">That’s a wrap.</h2>
      <div class="cta">
        <a href="#get" class="btn"><span data-os-label>Get Manul, free</span></a>
        <button class="brew mono" data-copy={brew} aria-label="Copy the Homebrew install command"><span>$ {brew}</span><em>copy</em></button>
      </div>
    </section>
  </main>

  <dialog class="film" id="film" aria-label="Manul, the film">
    <video id="film-v" controls playsinline preload="none" poster="/film/poster.jpg" width="1920" height="1080">
      <source src="/film/manul.mp4" type="video/mp4" />
      <track kind="captions" src="/captions/film.vtt" srclang="en" label="English" />
    </video>
    <button class="film-close" type="button" aria-label="Close the film">×</button>
  </dialog>

  <footer class="wrap label">
    <span>© Hormuz Labs · <a href={`${gh}/blob/main/LICENSE`}>GPL-3.0</a> · <a href={gh}>GitHub</a> · <a href="https://apt.manul.si">apt.manul.si</a></span>
    <span>Demo clip: “Manul Timofey”, Moscow Zoo, <a href="https://commons.wikimedia.org/wiki/File:%D0%9C%D0%B0%D0%BD%D1%83%D0%BB_%D0%A2%D0%B8%D0%BC%D0%BE%D1%84%D0%B5%D0%B9_%D0%BD%D0%B0_%D1%80%D0%B0%D0%B7%D0%B6%D0%B8%D1%80%D0%BE%D0%B2%D0%BA%D0%B5.webm">CC BY 4.0</a>, edited.</span>
  </footer>

  <script>
    // pick the right tab and button for this computer
    const ua = navigator.userAgent
    const os = /Mac/.test(ua) && !/iPhone|iPad/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null
    const label = os === 'mac' ? 'Get Manul for Mac' : os === 'linux' ? 'Get Manul for Linux' : 'Get Manul, free'
    document.querySelectorAll('[data-os-label]').forEach(el => (el.textContent = label))

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')]
    const show = (name: string) => tabs.forEach(t => {
      const on = t.dataset.tab === name
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
      document.getElementById('p-' + t.dataset.tab)!.hidden = !on
    })
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!))
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n.dataset.tab!); n.focus() }
      })
    })
    if (os === 'linux') show('linux')

    document.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-from]').forEach(b => b.addEventListener('click', async () => {
      const text = b.dataset.copy ?? b.previousElementSibling!.textContent!
      const out = b.querySelector('em') ?? b
      const was = out.textContent
      try { await navigator.clipboard.writeText(text); out.textContent = 'copied'; b.classList.add('ok') } catch { out.textContent = 'select & copy' }
      setTimeout(() => { out.textContent = was; b.classList.remove('ok') }, 1800)
    }))

    // the film opens in a player over the page
    const film = document.getElementById('film') as HTMLDialogElement, filmV = document.getElementById('film-v') as HTMLVideoElement
    document.querySelectorAll('[data-film]').forEach(b => b.addEventListener('click', () => { film.showModal(); filmV.play().catch(() => {}) }))
    film.querySelector('.film-close')!.addEventListener('click', () => film.close())
    film.addEventListener('click', e => { if (e.target === film) film.close() })
    film.addEventListener('close', () => filmV.pause())

    // china-marker notes draw themselves once they're on screen
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } }), { threshold: 0.4 })
    document.querySelectorAll('.ringed, .marks, .rules li, .edl .row').forEach(el => io.observe(el))

    // the cat plays only while he's on screen, and not at all for people who'd rather nothing moved
    const cat = document.getElementById('cat') as HTMLVideoElement
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([e]) => { if (e.isIntersecting) cat.play().catch(() => {}); else cat.pause() }, { rootMargin: '200px' }).observe(cat)
    }

    // the timecode: one frame per pixel scrolled, 24 fps
    const tc = document.getElementById('tc')!, bar = document.getElementById('bar')!
    const pad = (n: number) => String(n).padStart(2, '0')
    let queued = false
    addEventListener('scroll', () => {
      if (queued) return
      queued = true
      requestAnimationFrame(() => {
        const f = Math.round(scrollY / 2), s = Math.floor(f / 24)
        tc.textContent = `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(f % 24)}`
        bar.classList.toggle('on', scrollY > innerHeight * .8)
        queued = false
      })
    }, { passive: true })
  </script>

  <style>
    /* the china marker: hand strokes that draw in */
    .ringed svg path, .marks path { fill: none; stroke: var(--red); stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
    .ringed.in svg path, .marks.in path { transition: stroke-dashoffset .9s cubic-bezier(.6,.1,.3,1); stroke-dashoffset: 0; }
    .marks.in .m1 path:last-child, .marks.in .m2 path:last-child { transition-delay: .7s; }
    s { text-decoration: line-through transparent .1em; text-decoration-skip-ink: none; transition: text-decoration-color .5s ease .2s; }
    .in s { text-decoration-color: var(--red-ink); }
    @media (prefers-reduced-motion: reduce) {
      .ringed svg path, .marks path { stroke-dashoffset: 0; }
      s { text-decoration-color: var(--red-ink); transition: none; }
    }

    .bar { position: fixed; z-index: 20; inset: 0 0 auto; background: var(--ink); color: var(--paper); transform: translateY(-100%); transition: transform .3s ease; }
    .bar.on { transform: none; }
    .bar .wrap { display: flex; align-items: center; gap: 20px; height: 56px; }
    .bar .slate { font-size: 24px; }
    .bar .btn { margin-left: auto; white-space: nowrap; height: 38px; padding: 0 16px; font-size: 14.5px; background: var(--red-ink); }
    .bar .btn:hover { background: #e8492b; }
    .tc { display: flex; align-items: center; gap: 8px; font-size: 13px; letter-spacing: .04em; color: #b8ae9f; font-variant-numeric: tabular-nums; }
    .tc i { width: 7px; height: 7px; border-radius: 50%; background: var(--red); animation: blink 1.2s steps(2, start) infinite; }
    @keyframes blink { to { visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) { .tc i { animation: none; } }

    .top { display: flex; align-items: center; gap: 24px; height: 72px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
    .brand img { border-radius: 6px; }
    .brand .slate { font-size: 30px; line-height: 1; letter-spacing: .01em; }
    .meta { flex: 1; margin: 0; text-align: center; }
    nav { display: flex; gap: 22px; }
    nav a { text-decoration: none; font: 500 14px/1 var(--mono); color: var(--ink-2); }
    nav a:hover { color: var(--red-ink); }

    .hero { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 48px; align-items: end; padding: 28px 0 30px; }
    h1 { margin: 0; font-size: clamp(76px, 10.4vw, 150px); }
    .ringed { position: relative; display: inline-block; }
    .ringed svg { position: absolute; left: -9%; top: -14%; width: 118%; height: 128%; overflow: visible; pointer-events: none; }
    .ringed svg path { stroke-width: 7px; vector-effect: non-scaling-stroke; }
    .ringed { color: var(--red); }
    .lede { margin: 0; font-size: 19px; line-height: 1.5; color: var(--ink-2); }
    .cta { margin-top: 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
    .brew { display: inline-flex; gap: 14px; align-items: center; padding: 0; border: 0; background: none; cursor: pointer; font-size: 14px; color: var(--ink-2); }
    .brew em { font-style: normal; color: var(--red-ink); text-decoration: underline; text-underline-offset: 3px; }
    .brew.ok em { text-decoration: none; }
    .trust { margin: 22px 0 0; line-height: 1.6; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .film-open { display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 18px 0 14px; border: 2px solid var(--ink); border-radius: 4px; background: none; cursor: pointer; font: 650 16px/1 var(--sans); }
    .film-open i { width: 24px; height: 24px; border-radius: 50%; background: var(--red); position: relative; }
    .film-open i::after { content: ''; position: absolute; left: 9px; top: 7px; border-left: 9px solid var(--paper); border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
    .film-open span { font-size: 13px; font-weight: 500; color: var(--ink-3); }
    .film-open:hover { background: var(--ink); color: var(--paper); }
    .film-open:hover span { color: #b8ae9f; }
    .film { width: min(1200px, 100vw - 32px); max-width: none; max-height: none; padding: 0; border: 0; background: #000; color: var(--paper); overflow: visible; }
    .film::backdrop { background: rgba(23, 20, 15, .88); }
    .film video { display: block; width: 100%; height: auto; }
    .film-close { position: absolute; right: 0; top: -48px; width: 40px; height: 40px; border: 0; border-radius: 3px; background: var(--paper); color: var(--ink); font-size: 26px; line-height: 1; cursor: pointer; }
    .phone-only { display: none; margin: 10px 0 0; text-transform: none; letter-spacing: .02em; line-height: 1.6; }

    .stage { padding-bottom: 120px; }
    .marks.above { height: 74px; margin-bottom: 4px; }
    .marks.below { display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; margin-top: 10px; }
    .mark { position: relative; margin: 0; font: 500 14px/1.3 var(--mono); color: var(--red-ink); }
    .mark b { display: inline-grid; place-items: center; width: 22px; height: 22px; margin-right: 6px; border: 2px solid var(--red); border-radius: 50%; font-size: 12px; }
    .mark svg { position: absolute; width: 120px; height: 70px; overflow: visible; }
    .mark path { stroke-width: 2.4px; }
    .m1 { text-align: right; padding: 10px 120px 0 0; }
    .m1 svg { right: 0; top: 8px; }
    .m2 { display: flex; gap: 10px; align-items: flex-end; padding-left: 24%; line-height: 1.5; white-space: nowrap; }
    .m2 svg { position: static; flex: none; margin-bottom: 12px; }
    .mark.phone { display: none; margin: 0 0 14px; }
    .credit { flex: 0 1 470px; margin: 4px 0 0; text-align: right; text-transform: none; letter-spacing: .02em; line-height: 1.6; }

    .head { display: grid; gap: 18px; max-width: 1060px; }
    .head .label { margin: 0; }
    h2 { margin: 0; font-size: clamp(50px, 6.8vw, 96px); }
    .aside { margin: 4px 0 0; max-width: 620px; font-size: 18px; color: var(--ink-2); }

    .notes { padding: 110px 0; background: var(--paper-2); }
    .edl { margin-top: 56px; }
    .edl .row { display: grid; grid-template-columns: 56px minmax(0, 1.25fr) 150px minmax(0, 1fr); gap: 28px; align-items: baseline; padding: 26px 20px; }
    .edl .row:nth-child(even) { background: var(--paper-3); }
    .edl .th { padding-top: 0; padding-bottom: 14px; font: 500 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
    .edl .n { font-size: 13px; color: var(--ink-3); }
    .edl q { quotes: '“' '”'; font: 550 clamp(22px, 2.3vw, 29px)/1.2 var(--sans); font-variation-settings: 'wdth' 88; letter-spacing: -.01em; }
    .edl .at { font-size: 13.5px; color: var(--red-ink); }
    .edl .did { font-size: 16px; color: var(--ink-2); }
    .boxed { display: inline-block; vertical-align: .25em; margin-right: 8px; padding: 2px 7px; border: 2px dashed var(--red); color: var(--red-ink); font: 600 12px/1.3 var(--mono); font-style: normal; }
    .circled { padding: 0 .12em; box-shadow: inset 0 0 0 2.5px var(--red); border-radius: 3px; transform: rotate(-.6deg); display: inline-block; }

    .rules { padding: 120px 0; background: var(--ink); color: var(--paper); }
    .rules .label { color: #9a9081; }
    .rules .label b { color: #f0775a; }
    .rules h2 { margin-top: 18px; }
    .rules ol { list-style: none; margin: 64px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 56px 64px; }
    .rules li { display: grid; grid-template-columns: 36px 1fr; gap: 6px 14px; align-items: baseline; align-content: start; }
    .rules .n { color: #f0775a; font-size: 14px; }
    .rules h3 { margin: 0; font-size: clamp(38px, 4.2vw, 58px); line-height: .95; color: #d9d1c3; }
    .rules p { grid-column: 2; margin: 10px 0 0; max-width: 440px; color: #b8ae9f; font-size: 17px; }

    .fits { padding: 120px 0; }
    .cmp { margin-top: 52px; }
    .cmp .row { display: grid; grid-template-columns: .8fr 1fr 1fr 1fr 1fr; }
    .cmp small { display: block; margin-top: 8px; font: 400 12px/1.4 var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink-3); }
    .cmp .row > span { padding: 18px 20px; font-size: 16.5px; color: var(--ink-2); }
    .cmp .row:nth-child(even) > span { background: var(--paper-2); }
    .cmp .th > span { padding-top: 0; font: 500 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
    .cmp [role=rowheader] { font: 500 13px/1.6 var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
    .cmp .us { color: var(--ink) !important; font-weight: 650; background: var(--red-soft) !important; }
    .cmp .th .us { color: var(--red-ink) !important; padding-top: 16px; }

    .next { padding: 0 0 130px; }
    .reel { list-style: none; margin: 52px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
    .reel li { position: relative; padding: 30px 28px 32px; background: var(--paper-2); }
    .reel li:nth-child(2), .reel li:nth-child(3) { background: var(--paper-3); }
    .reel h3 { margin: 0; padding-right: 72px; font-size: clamp(36px, 3.6vw, 52px); }
    .reel p { margin: 14px 0 0; max-width: 460px; color: var(--ink-2); }
    .reel q { quotes: '“' '”'; color: var(--ink); font-weight: 600; }
    .reel .tag { position: absolute; top: 24px; right: 24px; padding: 3px 8px; border: 2px solid var(--red); color: var(--red-ink); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; transform: rotate(4deg); }
    .reel li:last-child .tag { border-color: var(--ink-3); color: var(--ink-3); }
    .next > .alt { margin-top: 24px; }
    .get { padding: 120px 0; background: var(--paper-2); }
    .get-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 48px; align-items: end; }
    .first { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; counter-reset: none; }
    .first li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; padding: 14px 16px; background: var(--paper-3); font-size: 16.5px; line-height: 1.45; }
    .first .mono { font-size: 13px; color: var(--red-ink); padding-top: 2px; }
    .first q { quotes: '“' '”'; font-weight: 600; }
    .tabs { display: flex; gap: 6px; margin-top: 48px; }
    .tabs button { height: 42px; padding: 0 18px; border: 0; border-radius: 3px; background: var(--paper-3); color: var(--ink-2); font: 500 14px/1 var(--mono); cursor: pointer; }
    .tabs button[aria-selected=true] { background: var(--ink); color: var(--paper); }
    .panel { margin-top: 18px; max-width: 920px; }
    .how { margin: 0 0 14px; color: var(--ink-2); }
    .cmd { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 20px; border-radius: 4px; background: var(--ink); color: var(--paper); }
    .cmd code { flex: 1; font: 500 16px/1.6 var(--mono); overflow-x: auto; white-space: pre; scrollbar-width: none; }
    .cmd code::before { content: '$ '; color: var(--red-ink); }
    .cmd.multi { align-items: flex-start; padding-block: 16px; }
    .cmd.multi code { font-size: 13.5px; line-height: 1.8; }
    .cmd.multi code::before { content: none; }
    .cmd.prose code { white-space: pre-wrap; font: 15px/1.6 var(--sans); color: #d9d1c3; }
    .copy { flex: none; height: 38px; min-width: 76px; padding: 0 14px; border: 0; border-radius: 3px; background: #2e2a24; color: var(--paper); font: 500 13px/1 var(--mono); cursor: pointer; }
    .copy:hover { background: #3c362f; }
    .copy.ok { background: var(--red); }
    .alt { margin: 16px 0 0; color: var(--ink-3); font-size: 15px; }
    .alt a, .qs a, footer a, .credit a { color: var(--ink-2); text-underline-offset: 3px; }
    .alt a:hover, .qs a:hover, footer a:hover { color: var(--red-ink); }
    .windows { margin-top: 36px; }

    .cat { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; align-items: center; padding: 130px 0; }
    .cat figure { position: relative; margin: 0; }
    .cat video { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 3px; background: var(--paper-3); }
    .cat figcaption { margin-top: 12px; text-transform: none; }
    .cat h2 { margin: 18px 0 26px; font-size: clamp(52px, 6.6vw, 92px); }
    .cat p:not(.label) { margin: 0 0 16px; font-size: 18px; color: var(--ink-2); max-width: 520px; }

    .faq { padding: 110px 0; background: var(--paper-2); }
    .qs { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 48px; }
    details { padding: 0; }
    summary { list-style: none; cursor: pointer; padding: 18px 0; font: 600 20px/1.3 var(--sans); font-variation-settings: 'wdth' 90; display: flex; justify-content: space-between; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; font: 500 20px/1.3 var(--mono); color: var(--red-ink); transition: transform .2s; }
    details[open] summary::after { transform: rotate(45deg); }
    details p { margin: 0 0 18px; color: var(--ink-2); }

    .wrap-up { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; padding: 140px 0 80px; }
    .wrap-up h2 { font-size: clamp(76px, 14vw, 200px); }

    footer { display: flex; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; padding: 26px 0 80px; text-transform: none; letter-spacing: .02em; line-height: 1.6; }

    @media (max-width: 980px) {
      .hero { grid-template-columns: 1fr; gap: 28px; }
      .pitch { max-width: 560px; }
      .marks.above, .m2 { display: none; }
      .marks.below { display: block; }
      .mark.phone { display: block; }
      .stage .credit { text-align: left; margin-top: 14px; }
      .edl .row { grid-template-columns: 44px minmax(0, 1fr); gap: 8px 16px; }
      .edl .row > :nth-child(n+3) { grid-column: 2; }
      .edl .th { display: none; }
      .rules ol { grid-template-columns: 1fr; gap: 40px; }
      .cat { grid-template-columns: 1fr; gap: 40px; }
      .qs { grid-template-columns: 1fr; }
      .get-top { grid-template-columns: 1fr; gap: 32px; }
      .reel { grid-template-columns: 1fr; }
      .reel li:nth-child(3) { background: var(--paper-2); }
      .reel li:nth-child(even) { background: var(--paper-3); }
    }
    @media (max-width: 360px) { .tc { display: none; } }
    @media (max-width: 760px) {
      .meta { display: none; }
      .top { justify-content: space-between; }
      nav { gap: 16px; }
      nav a:first-child { display: none; }
      .hero { padding-top: 24px; }
      .lede { font-size: 17.5px; }
      .stage { padding-bottom: 80px; }
      .notes, .rules, .fits, .get, .cat, .faq { padding-block: 80px; }
      .next { padding-bottom: 80px; }
      .reel li { padding: 24px 18px 26px; }
      .edl { margin-top: 36px; }
      .edl .row { padding: 20px 12px; }
      .cmp { margin-top: 36px; }
      .cmp .row.th { display: none; }
      .cmp .row { display: block; padding: 16px 0 12px; }
      .cmp .row:nth-child(even) { background: var(--paper-2); }
      .cmp .row > span { display: grid; grid-template-columns: 118px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 5px 14px; font-size: 15.5px; background: none !important; }
      .cmp .row > span::before { content: attr(data-h); font: 500 11px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
      .cmp .row > .us::before { color: var(--red-ink); }
      .cmp .row > .us { background: var(--red-soft) !important; padding-block: 8px; margin-top: 4px; }
      .cmp .row > [role=rowheader] { display: block; padding: 0 14px 6px; color: var(--ink); font-size: 13px; }
      .cmp .row > [role=rowheader]::before { content: none; }
      .hero .brew, .wrap-up .brew { display: none; }
      .phone-only { display: block; }
      .tabs button { font-size: 13px; }
      .cmd code { font-size: 14px; }
      .tabs button { flex: 1; padding: 0 8px; }
    }
  </style>
</body>
</html>
