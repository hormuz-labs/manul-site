---
import '@fontsource-variable/inter'
import '@fontsource/instrument-serif/400.css'
import '@fontsource/instrument-serif/400-italic.css'
import '../styles/global.css'
import Demo from '../components/Demo.astro'

// the latest release, read at build time; the page refreshes it in the browser too
let version = '0.1.0'
try {
  const r = await fetch('https://api.github.com/repos/hormuz-labs/manul/releases/latest', { headers: { 'User-Agent': 'manul-site' } })
  if (r.ok) version = (await r.json()).tag_name.replace(/^v/, '')
} catch {}
const dl = (f: string) => `https://github.com/hormuz-labs/manul/releases/download/v${version}/${f}`
const agentPrompt = 'Install Manul from https://github.com/hormuz-labs/manul. On macOS run `brew install hormuz-labs/tap/manul`. On Linux, add the apt repository at https://apt.manul.si (instructions on that page) and `sudo apt install manul`, or download the .deb or AppImage for this machine from the latest GitHub release. Then open Manul.'
const title = 'Manul: direct your video, it does the edit'
const description = 'Drop in your footage, say what you want, point at the frame. Manul edits on your own computer and shows a before / after of every change. Free and open source, for macOS and Linux.'
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0e0d0c" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://manul.si/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manul.si/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://manul.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/demo/before.mp4" as="video" type="video/mp4" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Manul', applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Linux', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: 'https://manul.si/',
    downloadUrl: 'https://github.com/hormuz-labs/manul/releases/latest', softwareVersion: version, license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  })} />
</head>
<body>
  <header class="top wrap">
    <a class="brand" href="/" aria-label="Manul home"><img src="/icon.png" width="30" height="30" alt="" />Manul</a>
    <nav>
      <a href="#how">How it works</a>
      <a href="#faq">FAQ</a>
      <a href="https://github.com/hormuz-labs/manul" class="gh" aria-label="Manul on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        GitHub
      </a>
      <a href="#get" class="btn btn-primary sm">Get Manul</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <p class="eyebrow">Free · open source · macOS &amp; Linux</p>
      <h1 class="serif">You direct.<br /><em>Manul edits.</em></h1>
      <p class="lede">Drop in your footage, say what you want, and point at the frame when something’s off. Manul makes the cut on your own computer and shows you a before&nbsp;/&nbsp;after of every change. You never touch a timeline.</p>
      <div class="cta">
        <a href="#get" class="btn btn-primary" data-os-cta>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>
          <span data-os-label>Get Manul, free</span>
        </a>
        <span class="try">or try it right here <span aria-hidden="true">↓</span></span>
      </div>
    </section>

    <section class="stage-section wrap" aria-label="Try Manul">
      <Demo />
    </section>

    <section class="asks-section" id="how">
      <div class="wrap">
        <p class="eyebrow">What people actually type</p>
        <h2 class="serif">Say it the way you’d say it<br />to an editor in the room.</h2>
        <ol class="reqs">
          <li><q>cut the ums, and the bit where I lose my train of thought</q><span>Every word is transcribed with its timing, so the cut lands on the exact word. <b>2:31 → 2:12.</b></span></li>
          <li><q><i class="chip">0:18 · box</i> blur this number plate</q><span>Your box pins the note to that spot and that moment. Only that part of the shot changes.</span></li>
          <li><q>put my name on screen when I introduce myself</q><span>A lower third, set in real type and timed to the word. You can still drag it around after.</span></li>
          <li><q>quiet music under the whole thing</q><span>Looped to the length of the film and dipped under every sentence. You hear the mix live, before anything renders.</span></li>
          <li><q>now a vertical one for Shorts, captions burned in</q><span>16:9, 9:16 and 1:1 from the same film, reframed on what matters.</span></li>
        </ol>
      </div>
    </section>

    <section class="principles wrap">
      <article>
        <p class="num">01</p>
        <h3>You point. It edits.</h3>
        <p>Draw a box on the frame, drag across a sentence, click the one wrong word in a title. Your note sits on that exact spot and moment, and that’s what Manul changes.</p>
      </article>
      <article>
        <p class="num">02</p>
        <h3>It proposes. You decide.</h3>
        <p>Nothing is overwritten. Every edit arrives as a new version you can scrub before and after, then keep or send back. Every version you kept is one click away.</p>
      </article>
      <article>
        <p class="num">03</p>
        <h3>Your pixels stay real.</h3>
        <p>Manul cuts <em>your</em> footage. It never generates fake frames. Titles and captions are real typography, drawn frame-perfect.</p>
      </article>
      <article>
        <p class="num">04</p>
        <h3>Your footage stays home.</h3>
        <p>Editing and even transcription run on your computer. The model you bring a key for only ever sees text and the odd still frame. No upload queue, no render farm.</p>
      </article>
    </section>

    <section class="compare-section">
      <div class="wrap">
        <p class="eyebrow">Where it fits</p>
        <h2 class="serif">Not another timeline.<br />Not a slot machine either.</h2>
        <div class="compare" role="table" aria-label="Manul compared with timeline editors and AI video generators">
          <div class="row head" role="row"><span role="columnheader"></span><span role="columnheader">Timeline editors</span><span role="columnheader">AI video generators</span><span role="columnheader" class="us">Manul</span></div>
          <div class="row" role="row"><span role="rowheader">How you work</span><span role="cell">Operate it, cut by cut</span><span role="cell">Prompt, hope, re-roll</span><span role="cell" class="us">Say it, point at it</span></div>
          <div class="row" role="row"><span role="rowheader">Your footage</span><span role="cell">Yours</span><span role="cell">Replaced by generated frames</span><span role="cell" class="us">Yours, untouched</span></div>
          <div class="row" role="row"><span role="rowheader">Where it runs</span><span role="cell">Your computer</span><span role="cell">Their cloud</span><span role="cell" class="us">Your computer</span></div>
          <div class="row" role="row"><span role="rowheader">Undo</span><span role="cell">Ctrl-Z, until it isn’t</span><span role="cell">Start over</span><span role="cell" class="us">Every version, kept</span></div>
          <div class="row" role="row"><span role="rowheader">Price</span><span role="cell">Subscription</span><span role="cell">Credits</span><span role="cell" class="us">Free · bring any model key</span></div>
        </div>
      </div>
    </section>

    <section class="get wrap" id="get">
      <p class="eyebrow">Version <span data-version>{version}</span></p>
      <h2 class="serif">Get Manul.</h2>
      <p class="sub">Free and open source. Bring a Claude, Gemini or OpenAI key, kept in your system’s keychain.</p>

      <div class="tabs" role="tablist" aria-label="Choose your system">
        <button role="tab" id="t-mac" aria-controls="p-mac" aria-selected="true" data-tab="mac">macOS</button>
        <button role="tab" id="t-linux" aria-controls="p-linux" aria-selected="false" data-tab="linux">Linux</button>
        <button role="tab" id="t-agent" aria-controls="p-agent" aria-selected="false" data-tab="agent">Ask your agent</button>
      </div>

      <div class="panel" role="tabpanel" id="p-mac" aria-labelledby="t-mac">
        <p class="how">One line in Terminal. Updates install themselves.</p>
        <div class="cmd"><code>brew install hormuz-labs/tap/manul</code><button class="copy" data-copy="brew install hormuz-labs/tap/manul">Copy</button></div>
        <p class="alt">No Homebrew? Download the app:
          <a href={dl(`Manul-${version}-arm64.dmg`)} data-file="Manul-{v}-arm64.dmg">Apple silicon</a> ·
          <a href={dl(`Manul-${version}-x64.dmg`)} data-file="Manul-{v}-x64.dmg">Intel</a>.
          While we finish Apple notarization, open it the first time with right-click → Open.</p>
      </div>
      <div class="panel" role="tabpanel" id="p-linux" aria-labelledby="t-linux" hidden>
        <p class="how">Debian and Ubuntu: add the signed repository once, then apt keeps Manul up to date.</p>
        <div class="cmd multi"><code>curl -fsSL https://apt.manul.si/manul.gpg | sudo gpg --dearmor -o /usr/share/keyrings/manul.gpg
echo "deb [signed-by=/usr/share/keyrings/manul.gpg] https://apt.manul.si stable main" | sudo tee /etc/apt/sources.list.d/manul.list
sudo apt update && sudo apt install manul</code><button class="copy" data-copy-from="prev">Copy</button></div>
        <p class="alt">Or download:
          <a href={dl(`manul_${version}_amd64.deb`)} data-file="manul_{v}_amd64.deb">.deb x64</a> ·
          <a href={dl(`manul_${version}_arm64.deb`)} data-file="manul_{v}_arm64.deb">.deb ARM</a> ·
          <a href={dl(`manul_${version}_x86_64.AppImage`)} data-file="manul_{v}_x86_64.AppImage">AppImage x64</a> ·
          <a href={dl(`manul_${version}_arm64.AppImage`)} data-file="manul_{v}_arm64.AppImage">AppImage ARM</a></p>
      </div>
      <div class="panel" role="tabpanel" id="p-agent" aria-labelledby="t-agent" hidden>
        <p class="how">Using Claude Code, Cursor or Codex? Paste this and let it do the install.</p>
        <div class="cmd multi prose"><code>{agentPrompt}</code><button class="copy" data-copy={agentPrompt}>Copy</button></div>
      </div>
      <p class="windows">Windows is on the <a href="https://github.com/hormuz-labs/manul/blob/main/ROADMAP.md">roadmap</a>.</p>
    </section>

    <section class="faq-section" id="faq">
      <div class="wrap narrow">
        <h2 class="serif">Questions</h2>
        <details><summary>Is it really free?</summary><p>Yes. Manul is open source under the GPL-3.0. You pay your model provider directly for what the agent uses, usually cents per edit, and Manul shows the running cost as you go.</p></details>
        <details><summary>Does my video get uploaded anywhere?</summary><p>No. Cutting, rendering and transcription happen on your computer. The model only receives text (your requests, the transcript) and, when it needs to look, a few still frames.</p></details>
        <details><summary>Which AI does it use?</summary><p>Your pick, per project: Claude, Gemini or GPT. Add a key in Settings. A single Manul key that covers every model is coming.</p></details>
        <details><summary>Do I need to know video editing?</summary><p>No. If you can describe what you want to a person, you can direct Manul. If you do know editing, you’ll get there faster: it understands “J-cut”, “punch in” and “duck the music”.</p></details>
        <details><summary>What can’t it do yet?</summary><p>Multi-camera sync, handing the cut to Premiere, Resolve or Final Cut, and Windows. All are on the <a href="https://github.com/hormuz-labs/manul/blob/main/ROADMAP.md">roadmap</a>, in the open.</p></details>
        <details><summary>Why is it called Manul?</summary><p>After the manul, the Pallas’s cat: small, patient, and unbothered by anything. That’s the editor we wanted in the room. The one in the demo is Timofey, from the Moscow Zoo.</p></details>
      </div>
    </section>

    <section class="last wrap">
      <img src="/icon.png" width="84" height="84" alt="" loading="lazy" />
      <h2 class="serif">Your next edit is one sentence away.</h2>
      <a href="#get" class="btn btn-primary"><span data-os-label>Get Manul, free</span></a>
    </section>
  </main>

  <footer class="wrap">
    <span>© Hormuz Labs · <a href="https://github.com/hormuz-labs/manul/blob/main/LICENSE">GPL-3.0</a> · <a href="https://github.com/hormuz-labs/manul">GitHub</a></span>
    <span>Demo clip: “Manul Timofey” by the Moscow Zoo, <a href="https://commons.wikimedia.org/wiki/File:%D0%9C%D0%B0%D0%BD%D1%83%D0%BB_%D0%A2%D0%B8%D0%BC%D0%BE%D1%84%D0%B5%D0%B9_%D0%BD%D0%B0_%D1%80%D0%B0%D0%B7%D0%B6%D0%B8%D1%80%D0%BE%D0%B2%D0%BA%D0%B5.webm">CC BY 4.0</a>, edited.</span>
  </footer>

  <script>
    // pick the right tab and button for this computer
    const ua = navigator.userAgent
    const os = /Mac/.test(ua) && !/iPhone|iPad/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null
    const label = os === 'mac' ? 'Get Manul for Mac' : os === 'linux' ? 'Get Manul for Linux' : 'Get Manul, free'
    document.querySelectorAll('[data-os-label]').forEach(el => (el.textContent = label))

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')]
    const show = (name: string) => tabs.forEach(t => {
      const on = t.dataset.tab === name
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
      document.getElementById('p-' + t.dataset.tab)!.hidden = !on
    })
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!))
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n.dataset.tab!); n.focus() }
      })
    })
    if (os === 'linux') show('linux')

    document.querySelectorAll<HTMLButtonElement>('.copy').forEach(b => b.addEventListener('click', async () => {
      const text = b.dataset.copy ?? b.previousElementSibling!.textContent!
      try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; b.classList.add('ok') } catch { b.textContent = 'Select & copy' }
      setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('ok') }, 1800)
    }))

    // a release may have shipped since this page was built
    fetch('https://api.github.com/repos/hormuz-labs/manul/releases/latest').then(r => r.ok ? r.json() : null).then(j => {
      if (!j) return
      const v = j.tag_name.replace(/^v/, '')
      document.querySelectorAll('[data-version]').forEach(el => (el.textContent = v))
      document.querySelectorAll<HTMLAnchorElement>('[data-file]').forEach(a => {
        a.href = `https://github.com/hormuz-labs/manul/releases/download/v${v}/${a.dataset.file!.replace('{v}', v)}`
      })
    }).catch(() => {})
  </script>

  <style>
    .top { display: flex; align-items: center; justify-content: space-between; height: 76px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; font-size: 18px; text-decoration: none; letter-spacing: -0.01em; }
    .brand img { border-radius: 8px; }
    nav { display: flex; align-items: center; gap: 6px; }
    nav a:not(.btn) { padding: 8px 12px; border-radius: 9px; text-decoration: none; color: var(--ink-2); font-size: 15px; transition: color .15s, background .15s; display: inline-flex; align-items: center; gap: 7px; }
    nav a:not(.btn):hover { color: var(--ink); background: var(--panel); }
    nav .gh svg { width: 17px; height: 17px; }
    .btn.sm { height: 40px; padding: 0 16px; font-size: 15px; margin-left: 6px; box-shadow: none; }

    .hero { padding: 40px 0 34px; text-align: center; }
    h1 { margin: 16px 0 0; font-size: clamp(50px, 7.6vw, 98px); line-height: .95; letter-spacing: -0.025em; }
    h1 em { font-style: italic; color: var(--amber); }
    .lede { max-width: 640px; margin: 22px auto 0; font-size: clamp(17px, 2.1vw, 20px); color: var(--ink-2); line-height: 1.55; }
    .cta { margin-top: 28px; display: flex; gap: 22px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .try { color: var(--ink-3); font-size: 15px; }

    .stage-section { padding: 18px 0 110px; }

    .asks-section { background: var(--bg-2); padding: 110px 0; }
    h2 { margin: 14px 0 0; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.02; letter-spacing: -0.02em; }
    .reqs { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 10px; }
    .reqs li { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 32px; align-items: baseline; padding: 24px 28px; border-radius: var(--radius); background: var(--panel); }
    .reqs q { font-family: var(--serif); font-size: clamp(23px, 2.6vw, 30px); line-height: 1.2; quotes: '“' '”'; color: var(--ink); }
    .reqs q::before, .reqs q::after { color: var(--ink-3); }
    .reqs .chip { display: inline-block; vertical-align: .32em; margin-right: 6px; padding: 3px 8px; border-radius: 7px; background: var(--amber-soft); color: var(--amber); font: 600 13px/1.3 var(--sans); font-style: normal; }
    .reqs span { color: var(--ink-2); font-size: 16px; }
    .reqs b { color: var(--amber); font-weight: 600; }

    .principles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; padding: 110px 0; }
    .principles article { padding: 28px 24px 30px; border-radius: var(--radius); background: var(--panel); }
    .principles .num { margin: 0; font: 500 13px/1 var(--mono); color: var(--amber); }
    .principles h3 { margin: 22px 0 10px; font: 400 27px/1.1 var(--serif); letter-spacing: -0.01em; }
    .principles p:last-child { margin: 0; color: var(--ink-2); font-size: 15.5px; }

    .compare-section { background: var(--bg-2); padding: 110px 0; }
    .compare { margin-top: 52px; border-radius: var(--radius); overflow: hidden; }
    .compare .row { display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; }
    .compare .row > span { padding: 18px 22px; background: var(--panel); font-size: 15.5px; color: var(--ink-2); }
    .compare .row:nth-child(even) > span { background: var(--panel-2); }
    .compare .head > span { background: var(--bg-2) !important; color: var(--ink-3); font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; padding-top: 0; }
    .compare [role=rowheader] { color: var(--ink); font-weight: 500; }
    .compare .us { color: var(--ink) !important; background: rgba(242,165,65,.09) !important; font-weight: 500; }
    .compare .head .us { color: var(--amber) !important; background: var(--bg-2) !important; }
    .compare .row:not(.head) .us { box-shadow: inset 3px 0 0 var(--amber); }

    .get { padding: 120px 0 90px; }
    .get .sub { margin: 16px 0 0; color: var(--ink-2); font-size: 18px; max-width: 560px; }
    .tabs { display: inline-flex; gap: 4px; margin-top: 40px; padding: 4px; border-radius: 12px; background: var(--panel); }
    .tabs button { height: 40px; padding: 0 18px; border: 0; border-radius: 9px; background: none; color: var(--ink-2); font-weight: 550; font-size: 15px; cursor: pointer; }
    .tabs button[aria-selected=true] { background: var(--panel-3); color: var(--ink); }
    .panel { margin-top: 14px; max-width: 860px; }
    .how { margin: 6px 0 14px; color: var(--ink-2); }
    .cmd { display: flex; align-items: center; gap: 12px; padding: 10px 10px 10px 20px; border-radius: 12px; background: var(--panel); }
    .cmd code { flex: 1; font: 500 16px/1.6 var(--mono); color: var(--ink); overflow-x: auto; white-space: pre; scrollbar-width: none; }
    .cmd code::before { content: '$ '; color: var(--amber); }
    .cmd.multi { align-items: flex-start; padding-top: 16px; padding-bottom: 16px; }
    .cmd.multi code { font-size: 14px; line-height: 1.75; }
    .cmd.multi code::before { content: none; }
    .cmd.prose code { white-space: pre-wrap; font-family: var(--sans); font-size: 15px; color: var(--ink-2); }
    .copy { flex: none; height: 38px; min-width: 76px; padding: 0 14px; border: 0; border-radius: 9px; background: var(--panel-3); font-weight: 600; font-size: 14px; cursor: pointer; transition: background .15s, color .15s; }
    .copy:hover { background: #352f29; }
    .copy.ok { background: var(--amber); color: var(--amber-ink); }
    .alt { margin: 16px 0 0; color: var(--ink-3); font-size: 15px; }
    .alt a, .windows a, details a, footer a { color: var(--ink-2); text-decoration-color: rgba(201,191,178,.35); text-underline-offset: 3px; }
    .alt a:hover, .windows a:hover, details a:hover, footer a:hover { color: var(--amber); }
    .windows { margin: 40px 0 0; color: var(--ink-3); font-size: 15px; }

    .faq-section { background: var(--bg-2); padding: 110px 0; }
    .narrow { max-width: 820px; }
    details { margin-top: 10px; border-radius: 12px; background: var(--panel); }
    details:first-of-type { margin-top: 40px; }
    summary { list-style: none; cursor: pointer; padding: 20px 24px; font-size: 18px; font-weight: 500; display: flex; justify-content: space-between; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; color: var(--amber); font-size: 22px; line-height: 1; transition: transform .2s; }
    details[open] summary::after { transform: rotate(45deg); }
    details p { margin: 0; padding: 0 24px 22px; color: var(--ink-2); }

    .last { padding: 130px 0 120px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 26px; }
    .last img { border-radius: 20px; }
    .last h2 { margin: 0; max-width: 760px; }

