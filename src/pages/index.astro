  <script>
    const root = document.documentElement
    const move = root.classList.contains('move')

    // pick the right tab and button for this computer
    const ua = navigator.userAgent
    const os = /Mac/.test(ua) && !/iPhone|iPad/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null
    const label = os === 'mac' ? 'Get Manul for Mac' : os === 'linux' ? 'Get Manul for Linux' : 'Get Manul, free'
    document.querySelectorAll('[data-os-label]').forEach(el => (el.textContent = label))

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')]
    const show = (name: string) => tabs.forEach(t => {
      const on = t.dataset.tab === name
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
      document.getElementById('p-' + t.dataset.tab)!.hidden = !on
    })
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!))
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n.dataset.tab!); n.focus() }
      })
    })
    if (os === 'linux') show('linux')

    document.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-from]').forEach(b => b.addEventListener('click', async () => {
      const text = b.dataset.copy ?? b.previousElementSibling!.textContent!
      const out = b.querySelector('em') ?? b
      const was = out.textContent
      try { await navigator.clipboard.writeText(text); out.textContent = 'copied'; b.classList.add('ok') } catch { out.textContent = 'select & copy' }
      setTimeout(() => { out.textContent = was; b.classList.remove('ok') }, 1800)
    }))

    // the film opens in a player over the page
    const film = document.getElementById('film') as HTMLDialogElement, filmV = document.getElementById('film-v') as HTMLVideoElement
    document.querySelectorAll('[data-film]').forEach(b => b.addEventListener('click', () => { film.showModal(); filmV.play().catch(() => {}) }))
    film.querySelector('.film-close')!.addEventListener('click', () => film.close())
    film.addEventListener('click', e => { if (e.target === film) film.close() })
    film.addEventListener('close', () => filmV.pause())

    // paintings load when their panel is a screen away
    const paints = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); paints.unobserve(e.target) } }), { rootMargin: '100% 0px' })
    document.querySelectorAll('.paint:not(.seen)').forEach(el => paints.observe(el))

    // motion examples: small silent previews from this site, fetched a screen early, playing while on screen;
    // a click opens the full one with sound and the prompt behind it
    const warm = new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) return
      const v = e.target as HTMLVideoElement
      v.preload = 'auto'; v.src = v.dataset.src!; warm.unobserve(v)
    }), { rootMargin: '120% 60%' })
    const reels = new IntersectionObserver(es => es.forEach(e => {
      const v = e.target as HTMLVideoElement
      if (e.isIntersecting && move) { if (!v.src) v.src = v.dataset.src!; v.play().catch(() => {}) } else v.pause()
    }), { threshold: 0.15 })
    document.querySelectorAll<HTMLVideoElement>('.reel-tile video').forEach(v => { warm.observe(v); reels.observe(v) })
    const exs = JSON.parse(document.getElementById('ex-data')!.textContent!)
    const ex = document.getElementById('ex') as HTMLDialogElement, exV = document.getElementById('ex-v') as HTMLVideoElement
    document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach(b => b.addEventListener('click', () => {
      const m = exs[Number(b.dataset.ex)]
      exV.src = m.video; exV.poster = m.poster
      document.getElementById('ex-title')!.textContent = m.title
      const who = document.getElementById('ex-who') as HTMLAnchorElement
      who.textContent = '@' + m.handle; who.href = 'https://x.com/' + m.handle
      ;(document.getElementById('ex-post') as HTMLAnchorElement).href = m.post
      document.getElementById('ex-prompt')!.textContent = m.prompt
      ex.querySelector('details')!.open = false
      ex.showModal(); exV.play().catch(() => {})
    }))
    ex.querySelector('.film-close')!.addEventListener('click', () => ex.close())
    ex.addEventListener('click', e => { if (e.target === ex) ex.close() })
    ex.addEventListener('close', () => exV.pause())

    // things rise in as they come on screen; the ring and the strike-through draw themselves
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } }), { threshold: 0.15, rootMargin: '0px 0px -6% 0px' })
    document.querySelectorAll('[data-r], .ringed, .edl .row').forEach(el => io.observe(el))

    // the cat plays only while he's on screen, and not at all for people who'd rather nothing moved
    const cat = document.getElementById('cat') as HTMLVideoElement
    if (move) new IntersectionObserver(([e]) => { if (e.isIntersecting) cat.play().catch(() => {}); else cat.pause() }, { rootMargin: '200px' }).observe(cat)

    // scroll-driven parts: the line that fills in, the readout that steps through its tracks, the paintings' drift
    const say = document.getElementById('say')!, chars = [...say.querySelectorAll<HTMLElement>('.ch')]
    const scrolly = document.querySelector<HTMLElement>('.scrolly')!, views = [...scrolly.querySelectorAll<HTMLElement>('.view')], steps = [...scrolly.querySelectorAll<HTMLButtonElement>('.tracks button')]
    const pinnable = () => move && innerWidth >= 900 && innerHeight >= 620
    let live = false, filled = -1, step = -1
    const setLive = () => {
      live = pinnable()
      say.classList.toggle('live', live); scrolly.classList.toggle('live', live)
      filled = -1; step = -1
    }
    const progress = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))) }
    steps.forEach((b, i) => b.addEventListener('click', () => {
      const r = scrolly.getBoundingClientRect(), span = r.height - innerHeight
      scrollTo({ top: scrollY + r.top + span * (i + .5) / steps.length, behavior: 'smooth' })
    }))
    const drift = [...document.querySelectorAll<HTMLElement>('.panel.paint, .sky, .dusk, .say-card, .faq-side')]
    const top = document.getElementById('top')!
    let queued = false
    const frame = () => {
      queued = false
      top.classList.toggle('on', scrollY > 8)
      if (!move) return
      if (live) {
        // the line fills from 15% to 85% of the way through its section, the newest letters in amber
        const n = Math.round(Math.min(1, Math.max(0, (progress(say) - .15) / .7)) * chars.length)
        if (n !== filled) { chars.forEach((c, i) => { c.classList.toggle('on', i < n); c.classList.toggle('lead', i < n && i >= n - 6) }); filled = n }
        const p = progress(scrolly) * views.length, s = Math.min(views.length - 1, Math.floor(p))
        if (s !== step) { views.forEach((v, i) => v.classList.toggle('on', i === s)); steps.forEach((b, i) => { b.classList.toggle('on', i === s); b.classList.toggle('done', i < s) }); step = s }
        scrolly.style.setProperty('--t', String(Math.min(1, (p - s) * 1.6)))
      }
      for (const el of drift) {
        const r = el.getBoundingClientRect()
        if (r.bottom < -200 || r.top > innerHeight + 200) continue
        el.style.setProperty('--py', `${((r.top + r.height / 2 - innerHeight / 2) * -.07).toFixed(1)}px`)
      }
    }
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(frame) } }
    setLive(); frame()
    addEventListener('scroll', queue, { passive: true })
    addEventListener('resize', () => { setLive(); queue() })
  </script>

  <style>
    /* a painting behind a panel: its own layer, so it can drift slower than the page; it loads once the panel is near */
    .paint { position: relative; isolation: isolate; overflow: hidden; background-color: var(--tint); }
    .paint::before { content: ''; position: absolute; z-index: -1; inset: -9% 0; background: var(--pos, center) / cover no-repeat; transform: translate3d(0, var(--py, 0px), 0); opacity: 0; transition: opacity .7s ease; }
    .paint.seen::before, html:not(.js) .paint::before { background-image: var(--img); opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .paint::before { transition: none; } }
    .panel { margin: 40px 8px 0; padding: clamp(14px, 5vw, 72px) clamp(10px, 4vw, 56px); border-radius: var(--r-lg); }
    .panel > * { max-width: 1120px; margin-inline: auto; }
    .sheet { background: rgba(255, 255, 255, .93); box-shadow: 0 40px 80px -44px rgba(30, 30, 20, .45), 0 0 0 1px rgba(255, 255, 255, .7); }
    @supports (backdrop-filter: blur(1px)) { .sheet { background: rgba(255, 255, 255, .86); backdrop-filter: blur(10px) saturate(1.1); -webkit-backdrop-filter: blur(10px) saturate(1.1); } }

    /* rising in */
    .js.move [data-r] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2, .7, .2, 1), transform .7s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--d, 0) * 90ms); }
    .js.move [data-r].in { opacity: 1; transform: none; }

    /* the ring and the strike: Manul's notes on the page, drawn in amber */
    .ringed { position: relative; display: inline-block; }
    .ringed svg { position: absolute; left: -5%; top: -16%; width: 113%; height: 132%; overflow: visible; pointer-events: none; }
    .ringed svg path { fill: none; stroke: var(--amber); stroke-width: 6px; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
    .ringed.in svg path { transition: stroke-dashoffset .9s cubic-bezier(.6,.1,.3,1) .6s; stroke-dashoffset: 0; }
    s { text-decoration: line-through transparent .1em; text-decoration-skip-ink: none; transition: text-decoration-color .5s ease .2s; }
    .in s { text-decoration-color: var(--amber); }
    @media (prefers-reduced-motion: reduce) {
      .ringed svg path { stroke-dashoffset: 0; }
      s { text-decoration-color: var(--amber); transition: none; }
    }

    /* header: links left, the cat in the middle, GitHub and Download right */
    .top { position: sticky; top: 0; z-index: 30; background: rgba(253, 253, 246, .82); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); transition: box-shadow .2s; }
    .top.on { box-shadow: 0 1px 0 var(--line-2); }
    .top-in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; height: 60px; padding: 0 20px; }
    .top nav { display: flex; gap: 4px; }
    .top nav a { padding: 8px 12px; border-radius: 8px; font: 500 14px/1 var(--sans); text-decoration: none; color: var(--ink); }
    .top nav a:hover { background: rgba(38, 38, 38, .06); }
    .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font: 800 19px/1 var(--sans); letter-spacing: -.02em; }
    .brand img { border-radius: 7px; }
    .acts { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }
    .gh { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); font: 600 14px/1 var(--sans); text-decoration: none; }
    .gh:hover { background: rgba(38, 38, 38, .05); }
    .gh svg { width: 16px; height: 16px; }

    /* the hero: a painted sky with the whole editor in the first screen */
    .hero { padding: 0 8px; }
    .sky { border-radius: var(--r-lg); padding: clamp(28px, 4.2vh, 60px) clamp(12px, 4vw, 56px) clamp(16px, 3vw, 40px); }
    .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 860px; margin: 0 auto; }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, .6); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font: 600 13.5px/1.2 var(--sans); text-decoration: none; }
    .dot-live { width: 7px; height: 7px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 3px var(--amber-soft); }
    h1 { margin: 16px 0 0; font-size: clamp(42px, min(6vw, 8.4vh), 76px); line-height: 1.02; letter-spacing: -.035em; }
    h1 .w { display: inline-block; }
    .move h1 .w { animation: blur-in .8s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
    @keyframes blur-in { from { opacity: 0; filter: blur(12px); transform: translateY(14px); } }
    .lede { margin: 14px 0 0; max-width: 800px; font-size: clamp(16.5px, 1.4vw, 18.5px); line-height: 1.5; color: #2f2f2c; }
    .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 22px; }
    .play { width: 22px; height: 22px; border-radius: 50%; background: var(--ink); position: relative; flex: none; }
    .play::after { content: ''; position: absolute; left: 8.5px; top: 6.5px; border-left: 8px solid #fff; border-top: 4.5px solid transparent; border-bottom: 4.5px solid transparent; }
    .dur { font-size: 12.5px; font-weight: 500; color: var(--ink-3); }
    .brew { display: inline-flex; gap: 12px; align-items: center; margin-top: 10px; padding: 6px 14px; border: 0; border-radius: 999px; background: rgba(255, 255, 255, .45); cursor: pointer; font-size: 13px; color: var(--ink-2); }
    .brew:hover { background: rgba(255, 255, 255, .7); }
    .brew em { font: 600 13px/1 var(--sans); font-style: normal; color: var(--amber-ink); }
    .stage { max-width: 1104px; margin: clamp(20px, 3.2vh, 40px) auto 0; }
    .glass { padding: 8px; border-radius: 24px; background: rgba(255, 255, 255, .34); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .6), 0 40px 80px -40px rgba(30, 40, 60, .45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
    .move .glass { animation: rise-in 1s cubic-bezier(.2, .7, .2, 1) .35s both; }
    @keyframes rise-in { from { opacity: 0; transform: translateY(40px) scale(.97); } }
    .steps { list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; }
    .steps li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border-radius: 999px; background: rgba(32, 32, 32, .86); color: #fff; font: 600 13.5px/1.2 var(--sans); }
    .steps b { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--amber); color: var(--ink); font-size: 12px; }
    .credit { margin: 14px auto 0; font-size: 13px; color: var(--ink-3); text-align: center; }
    .credit a { color: inherit; text-underline-offset: 3px; }
    .phone-only { display: none; }
    /* short windows: the editor matters more than the eyebrow and the brew line (both are elsewhere on the page) */
    @media (min-width: 900px) and (max-height: 920px) { .brew { display: none; } }
    @media (min-width: 900px) and (max-height: 820px) {
      .eyebrow { display: none; }
      h1 { margin-top: 0; }
      .lede { font-size: 16.5px; }
      .cta-row { margin-top: 16px; }
    }

    /* the line that fills in as you scroll */
    .say { padding: 8px 8px 0; }
    .say-card { display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 64vh; padding: clamp(48px, 8vw, 96px) clamp(20px, 6vw, 96px); border-radius: var(--r-lg); text-align: center; }
    .kicker { margin: 0 0 22px; padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, .62); font: 650 14px/1.2 var(--sans); }
    .say-text { margin: 0; max-width: 1040px; font: 800 clamp(30px, 4.4vw, 60px)/1.14 var(--sans); letter-spacing: -.03em; text-wrap: balance; }
    .sw { display: inline-block; white-space: nowrap; }
    .say.live { height: 260vh; }
    .say.live .say-pin { position: sticky; top: 68px; height: calc(100vh - 76px); display: flex; }
    .say.live .say-card { flex: 1; min-height: 0; }
    .say.live .ch { color: rgba(38, 38, 38, .2); transition: color .25s ease; }
    .say.live .ch.on { color: var(--ink); }
    .say.live .ch.lead { color: #c77a12; }

    /* section heads: centred, bold */
    .sh { max-width: 760px; margin: 0 auto; text-align: center; }
    .sh h2 { margin: 0; font-size: clamp(30px, 3.6vw, 44px); }
    .sh p { margin: 14px auto 0; max-width: 640px; font-size: 17.5px; color: var(--ink-2); text-wrap: pretty; }
    .sh a { color: var(--ink); text-underline-offset: 3px; }
    main > section:not(.hero):not(.say):not(.cta) { padding-top: clamp(80px, 10vw, 128px); }

    /* motion */
    .reels { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .reel-tile { position: relative; display: block; width: 100%; padding: 0; border: 0; background: var(--dark); cursor: pointer; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r); box-shadow: 0 0 0 4px rgba(255, 255, 255, .5), 0 30px 50px -30px rgba(20, 10, 40, .6); }
    .reel-tile video { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
    .reel-tile:hover video, .reel-tile:focus-visible video { transform: scale(1.03); }
    .slug { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; padding: 26px 14px 11px; font: 600 13px/1 var(--sans); color: #fff; background: linear-gradient(transparent, rgba(0, 0, 0, .6)); pointer-events: none; }
    .slug .mono { font-weight: 500; font-size: 12.5px; }
    .note { width: fit-content; margin: 24px auto 0; padding: 8px 16px; border-radius: 999px; background: rgba(32, 32, 32, .82); color: #f1efe8; font-size: 13.5px; text-align: center; }
    .note a { color: #fff; text-underline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) { .reel-tile video { transition: none; } }

    /* the notes: one white sheet on the peaks */
    .edl { border-radius: 20px; overflow: hidden; }
    .edl .row { display: grid; grid-template-columns: 44px minmax(0, 1.25fr) 140px minmax(0, 1fr); gap: 28px; align-items: baseline; padding: 24px 28px; border-top: 1px solid var(--line-2); }
    .js.move .edl .row:not(.th) { opacity: 0; transform: translateX(-14px); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
    .js.move .edl .row.in { opacity: 1; transform: none; }
    .edl .th { padding-block: 14px; border: 0; background: rgba(244, 243, 234, .8); font: 600 12.5px/1 var(--sans); color: var(--ink-3); }
    .edl .n { font-size: 13px; color: var(--ink-3); }
    .edl q { quotes: '“' '”'; font: 650 clamp(19px, 1.9vw, 23px)/1.3 var(--sans); letter-spacing: -.015em; }
    .edl .at { font-size: 13px; color: var(--amber-ink); }
    .edl .did { font-size: 15.5px; color: var(--ink-2); }
    .boxed { display: inline-block; vertical-align: .2em; margin-right: 8px; padding: 2px 8px; border: 2px dashed var(--amber); border-radius: 6px; color: var(--amber-ink); font: 700 12px/1.3 var(--sans); font-style: normal; }
    .ref { font: 600 .82em/1 var(--mono); color: var(--amber-ink); background: var(--amber-soft); padding: 3px 7px; border-radius: 6px; white-space: nowrap; }
    .circled { padding: 0 .14em; box-shadow: inset 0 0 0 2.5px var(--amber); border-radius: 6px; }

    /* what it measures: all six tracks as rows; on a big screen the panel pins and scrolling steps through them */
    .paper { padding: 8px 28px; border-radius: 20px; }
    .tracks { display: none; }
    .view { display: grid; grid-template-columns: 96px minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: start; padding: 20px 0; border-top: 1px solid var(--line-2); }
    .view:first-child { border-top: 0; }
    .lbl { margin: 0 0 6px; font: 600 12.5px/1 var(--sans); color: var(--ink-3); }
    .view .k { display: inline-flex; justify-self: start; padding: 5px 11px; border-radius: 999px; background: var(--dark); color: #fff; font: 650 13px/1.2 var(--sans); }
    .found { display: grid; gap: 10px; font-size: 14px; line-height: 1.65; color: var(--ink-2); }
    .found .mono { margin: 0; }
    .found :global(i) { font-style: normal; color: var(--ink); background: var(--bg-2); padding: 1px 7px; margin: 0 2px; border-radius: 5px; white-space: nowrap; }
    .say-it q { quotes: '“' '”'; font: 650 clamp(18px, 1.8vw, 22px)/1.3 var(--sans); letter-spacing: -.01em; }
    .trace :global(svg) { display: block; width: 100%; height: 28px; }
    .trace :global(.p) { fill: #d3d0c4; }
    .trace :global(.q) { fill: #8f8c82; }
    .trace :global(.r) { fill: var(--amber); }
    .trace :global(.h) { fill: rgba(242, 165, 65, .28); }
    .trace :global(.rl) { fill: none; stroke: #e0901f; stroke-width: 1.6; vector-effect: non-scaling-stroke; }
    .trace :global(.pf) { fill: #e6e3d8; }
    .craft { width: fit-content; max-width: 640px; margin: 24px auto 0; padding: 12px 20px; border-radius: 16px; background: rgba(32, 32, 32, .86); color: #f1efe8; font-size: 15.5px; text-align: center; }

    .scrolly.live { height: calc(var(--n) * 70vh + 100vh); }
    .scrolly.live .pin { position: sticky; top: 68px; height: calc(100vh - 76px); display: flex; }
    .scrolly.live .panel { flex: 1; display: flex; flex-direction: column; justify-content: center; margin-top: 0; }
    .scrolly.live .paper { width: 100%; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; padding: 32px 40px; }
    .scrolly.live .tracks { display: flex; flex-direction: column; gap: 6px; }
    .tracks button { position: relative; display: flex; align-items: center; justify-content: space-between; height: 46px; padding: 0 18px; border: 0; border-radius: 999px; background: none; color: var(--ink-3); font: 650 16px/1 var(--sans); text-align: left; cursor: pointer; transition: background .3s, color .3s; }
    .tracks button:hover { background: rgba(38, 38, 38, .05); }
    .tracks button i { width: 8px; height: 8px; border-radius: 50%; background: rgba(38, 38, 38, .15); transition: background .3s; }
    .tracks button.done { color: var(--ink-2); }
    .tracks button.done i { background: var(--amber); }
    .tracks button.on { background: var(--dark); color: #fff; }
    .tracks button.on i { background: var(--amber); box-shadow: 0 0 0 4px rgba(242, 165, 65, .25); }
    .scrolly.live .views { display: grid; align-items: center; }
    .scrolly.live .view { grid-area: 1 / 1; grid-template-columns: minmax(0, 1fr); gap: 26px; padding: 0; border: 0; opacity: 0; transform: translateY(16px); transition: opacity .45s ease, transform .45s cubic-bezier(.2, .7, .2, 1); pointer-events: none; }
    .scrolly.live .view.on { opacity: 1; transform: none; pointer-events: auto; }
    .scrolly.live .view .k { display: none; }
    .scrolly.live .found { font-size: 16px; }
    .scrolly.live .trace :global(svg) { height: 56px; }
    .scrolly.live .view.on .trace { clip-path: inset(0 calc((1 - var(--t, 1)) * 100%) 0 0); }
    .scrolly.live .say-it q { font-size: clamp(28px, 3.2vw, 44px); letter-spacing: -.03em; }

    /* where it fits */
    .cmp { border-radius: 20px; overflow: hidden; }
    .cmp .row { display: grid; grid-template-columns: .8fr 1fr 1fr 1fr 1fr; border-top: 1px solid var(--line-2); }
    .cmp .th { border: 0; background: rgba(244, 243, 234, .8); }
    .cmp small { display: block; margin-top: 6px; font: 400 12.5px/1.4 var(--sans); color: var(--ink-3); }
    .cmp .row > span { padding: 18px 20px; font-size: 15.5px; color: var(--ink-2); }
    .cmp .th > span { font: 700 14px/1.2 var(--sans); color: var(--ink); }
    .cmp [role=rowheader] { font: 600 14px/1.5 var(--sans); color: var(--ink-3); }
    .cmp .us { color: var(--ink) !important; font-weight: 650; background: rgba(242, 165, 65, .2); }
    .cmp .th .us { background: var(--dark); color: #fff !important; }
    .cmp .th .us small { color: rgba(255, 255, 255, .65); }

    /* coming next: cards with a strip of painting */
    .cards { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .cards li { overflow: hidden; border-radius: 18px; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
    .band { display: flex; align-items: flex-start; height: 120px; padding: 14px; }
    .cards h3, .cards p { padding: 0 22px; }
    .cards p { padding-bottom: 24px; }
    .cards h3, .first h3 { margin: 18px 0 0; font-size: 19px; letter-spacing: -.015em; }
    .cards p, .first p { margin: 8px 0 0; font-size: 15.5px; color: var(--ink-2); }
    .cards q, .first q { quotes: '“' '”'; color: var(--ink); font-weight: 650; }
    .tag { display: inline-flex; padding: 5px 11px; border-radius: 999px; background: rgba(32, 32, 32, .86); color: #fff; font: 700 12.5px/1.2 var(--sans); }
    .tag.later { background: rgba(255, 255, 255, .85); color: var(--ink-2); }

    /* install */
    .first { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .first li { padding: 24px; border-radius: 18px; }
    .num { font: 600 13px/1 var(--mono); color: var(--amber-ink); }
    .first h3 { margin-top: 14px; }
    .install { margin-top: 16px; padding: 24px; border-radius: 20px; }
    .tabs { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(38, 38, 38, .07); }
    .tabs button { height: 38px; padding: 0 18px; border: 0; border-radius: 999px; background: none; color: var(--ink-2); font: 600 14px/1 var(--sans); cursor: pointer; }
    .tabs button[aria-selected=true] { background: var(--ink); color: #fff; }
    .tabpanel { margin-top: 20px; }
    .how { margin: 0 0 12px; color: var(--ink-2); }
    .cmd { display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 20px; border-radius: 14px; background: var(--dark); color: #f4f2ec; }
    .cmd code { flex: 1; font: 500 15.5px/1.6 var(--mono); overflow-x: auto; white-space: pre; scrollbar-width: none; }
    .cmd code::before { content: '$ '; color: var(--amber); }
    .cmd.multi { align-items: flex-start; padding-block: 14px; }
    .cmd.multi code { font-size: 13px; line-height: 1.8; }
    .cmd.multi code::before { content: none; }
    .cmd.prose code { white-space: pre-wrap; font: 15px/1.6 var(--sans); color: #dedbd2; }
    .copy { flex: none; height: 38px; min-width: 76px; padding: 0 16px; border: 0; border-radius: 999px; background: rgba(255, 255, 255, .12); color: #fff; font: 600 13.5px/1 var(--sans); cursor: pointer; }
    .copy:hover { background: rgba(255, 255, 255, .2); }
    .copy.ok { background: var(--amber); color: var(--ink); }
    .alt { margin: 14px 0 0; color: var(--ink-3); font-size: 14.5px; }
    .alt a, .qs a, .credit a, .faq-side a { color: var(--ink-2); text-underline-offset: 3px; }
    .alt a:hover, .qs a:hover { color: var(--ink); }
    .windows { margin-top: 20px; }

    /* open source: painted tiles */
    .oss-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
    .oss-head h2 { margin: 0; font-size: clamp(28px, 3vw, 36px); }
    .oss-head p { margin: 6px 0 0; color: var(--ink-2); }
    .bento { margin-top: 28px; display: grid; grid-template-columns: 1.1fr 1.4fr .9fr; grid-template-rows: 220px 220px; gap: 12px; }
    .tile { display: flex; flex-direction: column; justify-content: flex-end; padding: 22px 24px; border-radius: 18px; color: #fff; text-decoration: none; }
    .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(20, 20, 10, .42)); }
    .tile .big { font: 800 clamp(34px, 4vw, 54px)/1 var(--sans); letter-spacing: -.035em; text-shadow: 0 2px 18px rgba(0, 0, 0, .25); }
    .tile .what { margin-top: 8px; font: 600 15px/1.3 var(--sans); }
    .tile .go { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, .88); color: var(--ink); font-size: 14px; transition: transform .2s; }
    .tile:hover .go { transform: translate(2px, -2px); }
    .tile::before { transition: opacity .7s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
    .tile:hover::before { transform: scale(1.05); }
    .t1 { grid-column: 1 / 3; }
    .t2 { grid-row: 1 / 3; grid-column: 3; }
    .t5 { display: none; }

    /* the cat, on his rocks */
    .cat .panel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: center; }
    .cat .panel > * { max-width: none; margin: 0; }
    .cat figure { margin: 0; }
    .cat video { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; background: var(--bg-2); box-shadow: 0 0 0 6px rgba(255, 255, 255, .55), 0 40px 80px -40px rgba(40, 25, 10, .6); }
    .cat figcaption { width: fit-content; margin-top: 14px; padding: 5px 12px; border-radius: 999px; background: rgba(255, 255, 255, .7); font-size: 13px; color: var(--ink-2); }
    .cat-copy { padding: clamp(22px, 3vw, 36px); border-radius: 20px; }
    .cat h2 { margin: 12px 0 18px; font-size: clamp(30px, 3.6vw, 44px); }
    .cat-copy p:not(.label) { margin: 0 0 14px; font-size: 17px; color: var(--ink-2); }
    .cat-copy p:last-child { margin-bottom: 0; }
    .cat .label { margin: 0; }

    /* questions, beside a painted card */
    .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; align-items: start; }
    .faq-side { position: sticky; top: 84px; display: flex; flex-direction: column; justify-content: flex-end; min-height: 300px; padding: 28px; border-radius: var(--r-lg); }
    .faq-side h2 { margin: 0; font-size: clamp(36px, 4vw, 52px); }
    .faq-side p { margin: 8px 0 0; color: var(--ink-2); }
    .qs details { border-bottom: 1px solid var(--line); }
    .qs details:first-child { border-top: 1px solid var(--line); }
    summary { list-style: none; cursor: pointer; padding: 20px 0; font: 600 17.5px/1.35 var(--sans); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); font: 500 18px/1 var(--sans); transition: transform .2s, background .2s; }
    details[open] summary::after { transform: rotate(45deg); background: var(--ink); color: #fff; box-shadow: none; }
    details p { margin: 0 0 20px; max-width: 680px; color: var(--ink-2); }

    /* the closing card */
    .cta { padding: clamp(80px, 10vw, 128px) 8px clamp(80px, 10vw, 128px); }
    .dusk { display: flex; flex-direction: column; align-items: center; text-align: center; padding: clamp(56px, 8vw, 104px) 20px; border-radius: var(--r-lg); }
    .dusk img { width: 116px; height: 116px; filter: drop-shadow(0 18px 22px rgba(60, 30, 10, .35)); } /* the PNG has the macOS icon margin; the shadow follows the tile */
    .dusk h2 { margin: 14px 0 0; font-size: clamp(36px, 5vw, 60px); letter-spacing: -.035em; }
    .dusk p { margin: 12px 0 0; font-size: 18px; color: #2f2a24; }
    .dusk .cta-row { margin-top: 28px; }

    /* the film and the motion examples open over the page */
    .film { width: min(1200px, 100vw - 32px); max-width: none; max-height: none; padding: 0; border: 0; border-radius: 16px; background: #000; color: #fff; overflow: visible; }
    .film::backdrop { background: rgba(20, 20, 18, .82); backdrop-filter: blur(4px); }
    .film video { display: block; width: 100%; height: auto; border-radius: 16px; }
    .film-close { position: absolute; right: 0; top: -50px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #fff; color: var(--ink); font-size: 24px; line-height: 1; cursor: pointer; }
    .ex { width: min(1100px, 100vw - 32px, 108vh); } /* the video ≤ 61vh tall, so it and the prompt fit the window */
    .ex video { border-radius: 16px 16px 0 0; }
    .ex-info { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 18px 22px 20px; border-radius: 0 0 16px 16px; background: var(--dark); }
    .ex-title { margin: 0; font: 800 24px/1.1 var(--sans); letter-spacing: -.02em; }
    .ex-by { margin: 8px 0 0; font-size: 13.5px; color: #b9b7af; }
    .ex-by a { color: #fff; }
    .ex .film-close { top: 10px; right: 10px; z-index: 1; background: rgba(0, 0, 0, .5); color: #fff; }
    .ex-info summary { padding: 0; font: 600 13.5px/1.4 var(--sans); color: var(--amber); }
    .ex-info summary::after { content: none; }
    .ex-info pre { margin: 10px 0 0; max-height: 22vh; overflow: auto; white-space: pre-wrap; font: 400 12.5px/1.55 var(--mono); color: #d9d7cf; }

    /* footer */
    .foot { background: var(--dark); color: #f4f3ee; padding: 64px 0 32px; }
    .foot-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; }
    .foot .brand { font-size: 22px; }
    .foot-brand p { margin: 16px 0 0; max-width: 300px; font-size: 15px; color: #a9a8a1; }
    .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .cols h3 { margin: 0 0 14px; font: 600 12.5px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: #8d8c86; }
    .cols a { display: block; padding: 5px 0; font-size: 15px; color: #f4f3ee; text-decoration: none; }
    .cols a:hover { color: var(--amber); }
    .foot-base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, .1); font-size: 13.5px; color: #8d8c86; }
    .foot-base a { color: #c9c8c1; text-underline-offset: 3px; }

    /* wide screens: the painted panels stop growing */
    @media (min-width: 1700px) { .panel, .sky, .say-card, .dusk { max-width: 1680px; margin-inline: auto; } .say.live .say-pin { justify-content: center; } }

    @media (max-width: 1100px) {
      .top nav a.more { display: none; }
      .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 980px) {
      .reels { grid-template-columns: repeat(2, 1fr); }
      .ex-info { grid-template-columns: 1fr; }
      .edl .row { grid-template-columns: 36px minmax(0, 1fr); gap: 8px 14px; padding: 20px; }
      .edl .row > :nth-child(n+3) { grid-column: 2; }
      .edl .th { display: none; }
      .view { grid-template-columns: 1fr; gap: 10px; padding: 18px 0; }
      .cat .panel { grid-template-columns: 1fr; }
      .faq { grid-template-columns: 1fr; gap: 20px; }
      .faq-side { position: relative; top: auto; min-height: 180px; } /* not static: the painting layer is positioned against it */
      .first { grid-template-columns: 1fr; }
      .bento { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 180px; }
      .t1 { grid-column: 1 / 3; }
      .t2 { grid-row: auto; grid-column: auto; }
      .t5 { display: flex; grid-column: 1 / 3; }
      .foot-top { grid-template-columns: 1fr; }
    }
    @media (max-width: 820px) {
      .top-in { grid-template-columns: auto 1fr; padding: 0 14px; }
      .top nav { display: none; }
    }
    @media (max-width: 760px) {
      .hero, .cta, .say { padding-inline: 6px; }
      .panel { margin-inline: 6px; margin-top: 28px; }
      .sky, .say-card, .dusk, .panel { border-radius: 22px; }
      /* phones: the copy tightens so the video frame is on the first screen */
      .sky { padding-top: 22px; }
      .eyebrow { font-size: 12.5px; padding: 5px 12px; }
      h1 { margin-top: 12px; font-size: clamp(36px, 10.5vw, 44px); }
      .lede { margin-top: 10px; font-size: 15.5px; line-height: 1.45; }
      .cta-row { margin-top: 16px; gap: 8px; }
      .hero .btn { height: 44px; font-size: 14px; }
      .hero .btn.dot { padding-left: 5px; }
      .hero .btn .ic { width: 32px; height: 32px; }
      .hero .btn.light { padding: 0 14px; }
      .hero .btn.light .dur { display: none; }
      .stage { margin-top: 18px; }
      .glass { padding: 5px; border-radius: 18px; }
      .hero .brew, .gh span, .steps { display: none; }
      .gh { width: 38px; padding: 0; justify-content: center; }
      .phone-only { display: inline; }
      .say-card { min-height: 0; }
      .paper { padding: 4px 16px; }
      .cmp .row.th { display: none; }
      .cmp .row { display: block; padding: 14px 0 10px; }
      .cmp .row > span { display: grid; grid-template-columns: 118px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 5px 16px; font-size: 15px; background: none; }
      .cmp .row > span::before { content: attr(data-h); font: 600 12px/1.4 var(--sans); color: var(--ink-3); }
      .cmp .row > .us::before { color: var(--amber-ink); }
      .cmp .row > .us { background: rgba(242, 165, 65, .2); padding-block: 8px; margin-top: 4px; }
      .cmp .row > [role=rowheader] { display: block; padding: 0 16px 6px; color: var(--ink); font-weight: 700; }
      .cmp .row > [role=rowheader]::before { content: none; }
      .cards { grid-template-columns: 1fr; }
      .band { height: 96px; }
      .install { padding: 16px; }
      .tabs { display: flex; }
      .tabs button { flex: 1; padding: 0 8px; font-size: 13px; }
      .cmd code { font-size: 14px; }
      .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 560px) {
      /* the motion tiles: a row you swipe, the next one peeking in, instead of three screens of stacked video */
      .reels { display: flex; gap: 12px; margin: 0 -10px; padding: 6px 10px 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 10px; scrollbar-width: none; overscroll-behavior-x: contain; }
      .reels::-webkit-scrollbar { display: none; }
      .reels li { flex: 0 0 84%; scroll-snap-align: start; }
      .js.move .reels li[data-r] { transform: none; }
      .bento { grid-template-columns: 1fr; grid-auto-rows: 160px; }
      .t1, .t5 { grid-column: auto; }
      .acts .btn { padding: 0 14px; }
    }
  </style>
</body>
</html>
