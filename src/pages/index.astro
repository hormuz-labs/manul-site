  <script>
    const root = document.documentElement
    const move = root.classList.contains('move')

    // pick the right tab and button for this computer
    const ua = navigator.userAgent
    const os = /Mac/.test(ua) && !/iPhone|iPad/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null
    const label = os === 'mac' ? 'Download for Mac' : os === 'linux' ? 'Download for Linux' : 'Download Manul'
    document.querySelectorAll('[data-os-label]').forEach(el => (el.textContent = label))

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.install [role=tab]')]
    const show = (name: string) => tabs.forEach(t => {
      const on = t.dataset.tab === name
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
      document.getElementById('p-' + t.dataset.tab)!.hidden = !on
    })
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!))
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n.dataset.tab!); n.focus() }
      })
    })
    if (os === 'linux') show('linux')

    document.querySelectorAll<HTMLButtonElement>('[data-copy], [data-copy-from]').forEach(b => b.addEventListener('click', async () => {
      const text = b.dataset.copy ?? b.previousElementSibling!.textContent!
      const out = b.querySelector('em') ?? b
      const was = out.textContent
      try { await navigator.clipboard.writeText(text); out.textContent = 'copied'; b.classList.add('ok') } catch { out.textContent = 'select & copy' }
      setTimeout(() => { out.textContent = was; b.classList.remove('ok') }, 1800)
    }))

    // the hero's prompt box: each chip swaps in an example of that kind of film
    const promptText = document.getElementById('prompt-text')!
    const chipBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-prompt]')]
    chipBtns.forEach(b => b.addEventListener('click', () => {
      chipBtns.forEach(c => c.setAttribute('aria-pressed', String(c === b)))
      promptText.textContent = b.dataset.prompt!
      promptText.classList.remove('swap'); void promptText.offsetWidth; promptText.classList.add('swap')
    }))

    // many kinds of film: tabs, and the shown result plays while it's on screen
    const ftabs = [...document.querySelectorAll<HTMLButtonElement>('[data-ftab]')]
    const fpanels = ftabs.map(t => document.getElementById(t.getAttribute('aria-controls')!)!)
    let filmsOn = false
    const fvideo = (i: number) => fpanels[i].querySelector('video') as HTMLVideoElement
    const fplay = (i: number) => { const v = fvideo(i); if (!v.src) v.src = v.dataset.src!; if (filmsOn && move) v.play().catch(() => {}) }
    const fshow = (n: number) => ftabs.forEach((t, i) => {
      const on = i === n
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
      fpanels[i].hidden = !on
      if (on) fplay(i); else fvideo(i).pause()
    })
    ftabs.forEach((t, i) => {
      t.addEventListener('click', () => fshow(i))
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (d) { const n = (i + d + ftabs.length) % ftabs.length; fshow(n); ftabs[n].focus() }
      })
    })
    new IntersectionObserver(([e]) => {
      filmsOn = e.isIntersecting
      const i = ftabs.findIndex(t => t.getAttribute('aria-selected') === 'true')
      if (filmsOn) fplay(i); else fvideo(i).pause()
    }, { rootMargin: '200px' }).observe(document.getElementById('films')!)

    // the film opens in a player over the page
    const film = document.getElementById('film') as HTMLDialogElement, filmV = document.getElementById('film-v') as HTMLVideoElement
    document.querySelectorAll('[data-film]').forEach(b => b.addEventListener('click', () => { film.showModal(); filmV.play().catch(() => {}) }))
    film.querySelector('.film-close')!.addEventListener('click', () => film.close())
    film.addEventListener('click', e => { if (e.target === film) film.close() })
    film.addEventListener('close', () => filmV.pause())

    // paintings load when their panel is a screen away
    const paints = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); paints.unobserve(e.target) } }), { rootMargin: '100% 0px' })
    document.querySelectorAll('.paint:not(.seen)').forEach(el => paints.observe(el))

    // motion examples: small silent previews from this site, fetched a screen early, playing while on screen;
    // a click opens the full one with sound and the prompt behind it
    const warm = new IntersectionObserver(es => es.forEach(e => {
      if (!e.isIntersecting) return
      const v = e.target as HTMLVideoElement
      v.preload = 'auto'; v.src = v.dataset.src!; warm.unobserve(v)
    }), { rootMargin: '120% 60%' })
    const reels = new IntersectionObserver(es => es.forEach(e => {
      const v = e.target as HTMLVideoElement
      if (e.isIntersecting && move) { if (!v.src) v.src = v.dataset.src!; v.play().catch(() => {}) } else v.pause()
    }), { threshold: 0.15 })
    document.querySelectorAll<HTMLVideoElement>('.reel-tile video').forEach(v => { warm.observe(v); reels.observe(v) })
    const exs = JSON.parse(document.getElementById('ex-data')!.textContent!)
    const ex = document.getElementById('ex') as HTMLDialogElement, exV = document.getElementById('ex-v') as HTMLVideoElement
    document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach(b => b.addEventListener('click', () => {
      const m = exs[Number(b.dataset.ex)]
      exV.src = m.video; exV.poster = m.poster
      document.getElementById('ex-title')!.textContent = m.title
      const who = document.getElementById('ex-who') as HTMLAnchorElement
      who.textContent = '@' + m.handle; who.href = 'https://x.com/' + m.handle
      ;(document.getElementById('ex-post') as HTMLAnchorElement).href = m.post
      document.getElementById('ex-prompt')!.textContent = m.prompt
      ex.querySelector('details')!.open = false
      ex.showModal(); exV.play().catch(() => {})
    }))
    ex.querySelector('.film-close')!.addEventListener('click', () => ex.close())
    ex.addEventListener('click', e => { if (e.target === ex) ex.close() })
    ex.addEventListener('close', () => exV.pause())

    // things rise in as they come on screen; the ring and the strike-through draw themselves
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } }), { threshold: 0.15, rootMargin: '0px 0px -6% 0px' })
    document.querySelectorAll('[data-r], .ringed, .edl .row').forEach(el => io.observe(el))

    // the cat plays only while he's on screen, and not at all for people who'd rather nothing moved
    const cat = document.getElementById('cat') as HTMLVideoElement
    if (move) new IntersectionObserver(([e]) => { if (e.isIntersecting) cat.play().catch(() => {}); else cat.pause() }, { rootMargin: '200px' }).observe(cat)

    // scroll-driven parts: the line that fills in, the readout that steps through its tracks, the paintings' drift
    const say = document.getElementById('say')!, chars = [...say.querySelectorAll<HTMLElement>('.ch')]
    const scrolly = document.querySelector<HTMLElement>('.scrolly')!, views = [...scrolly.querySelectorAll<HTMLElement>('.view')], steps = [...scrolly.querySelectorAll<HTMLButtonElement>('.tracks button')]
    const pinnable = () => move && innerWidth >= 900 && innerHeight >= 620
    let live = false, filled = -1, step = -1
    const setLive = () => {
      live = pinnable()
      say.classList.toggle('live', live); scrolly.classList.toggle('live', live)
      filled = -1; step = -1
    }
    const progress = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))) }
    steps.forEach((b, i) => b.addEventListener('click', () => {
      const r = scrolly.getBoundingClientRect(), span = r.height - innerHeight
      scrollTo({ top: scrollY + r.top + span * (i + .5) / steps.length, behavior: 'smooth' })
    }))
    const drift = [...document.querySelectorAll<HTMLElement>('.panel.paint, .sky, .dusk, .say-card, .faq-side')]
    const top = document.getElementById('top')!
    let queued = false
    const frame = () => {
      queued = false
      top.classList.toggle('on', scrollY > 8)
      if (!move) return
      if (live) {
        // the line fills from 15% to 85% of the way through its section, the newest letters in amber
        const n = Math.round(Math.min(1, Math.max(0, (progress(say) - .15) / .7)) * chars.length)
        if (n !== filled) { chars.forEach((c, i) => { c.classList.toggle('on', i < n); c.classList.toggle('lead', i < n && i >= n - 6) }); filled = n }
        const p = progress(scrolly) * views.length, s = Math.min(views.length - 1, Math.floor(p))
        if (s !== step) { views.forEach((v, i) => v.classList.toggle('on', i === s)); steps.forEach((b, i) => { b.classList.toggle('on', i === s); b.classList.toggle('done', i < s) }); step = s }
        scrolly.style.setProperty('--t', String(Math.min(1, (p - s) * 1.6)))
      }
      for (const el of drift) {
        const r = el.getBoundingClientRect()
        if (r.bottom < -200 || r.top > innerHeight + 200) continue
        el.style.setProperty('--py', `${((r.top + r.height / 2 - innerHeight / 2) * -.07).toFixed(1)}px`)
      }
    }
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(frame) } }
    setLive(); frame()
    addEventListener('scroll', queue, { passive: true })
    addEventListener('resize', () => { setLive(); queue() })
  </script>

  <style>
    /* the ring and the strike: Manul's notes on the page, drawn in amber */
