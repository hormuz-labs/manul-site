    .cmp .th { border: 0; background: rgba(244, 243, 234, .8); }
    .cmp small { display: block; margin-top: 6px; font: 400 12.5px/1.4 var(--sans); color: var(--ink-3); }
    .cmp .row > span { padding: 18px 20px; font-size: 15.5px; color: var(--ink-2); }
    .cmp .th > span { font: 700 14px/1.2 var(--sans); color: var(--ink); }
    .cmp [role=rowheader] { font: 600 14px/1.5 var(--sans); color: var(--ink-3); }
    .cmp .us { color: var(--ink) !important; font-weight: 650; background: rgba(242, 165, 65, .2); }
    .cmp .th .us { background: var(--dark); color: #fff !important; }
    .cmp .th .us small { color: rgba(255, 255, 255, .65); }


    /* the hero's prompt box and the kinds of video under it */
    .prompt { display: flex; align-items: center; gap: 12px; width: min(680px, 100%); margin-top: 20px; padding: 10px 10px 10px 20px; border-radius: 20px; background: rgba(255, 255, 255, .82); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .8), 0 20px 40px -24px rgba(30, 40, 60, .45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); text-align: left; }
    .prompt-text { flex: 1; margin: 0; min-height: 3em; display: flex; align-items: center; font: 500 16px/1.5 var(--sans); color: var(--ink); }
    .prompt-text.swap { animation: fade-in .35s ease both; }
    @keyframes fade-in { from { opacity: 0; transform: translateY(4px); } }
    .prompt-go { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--ink); color: #fff; }
    .prompt-go svg { width: 18px; height: 18px; }
    .chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; max-width: 980px; margin: 12px 0 0; padding: 0; }
    .chips button { height: 32px; padding: 0 13px; border: 0; border-radius: 999px; background: rgba(255, 255, 255, .5); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7); font: 600 13.5px/1 var(--sans); color: var(--ink-2); cursor: pointer; }
    .chips button:hover { background: rgba(255, 255, 255, .8); }
    .chips button[aria-pressed=true] { background: var(--ink); color: #fff; box-shadow: none; }
    @media (prefers-reduced-motion: reduce) { .prompt-text.swap { animation: none; } }

    /* many kinds of film: prompt, steps, result */
    .film-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; width: fit-content; max-width: 100%; margin: 0 auto 16px; padding: 4px; border-radius: 999px; background: rgba(255, 255, 255, .6); }
    .film-tabs button { height: 40px; padding: 0 18px; border: 0; border-radius: 999px; background: none; color: var(--ink-2); font: 650 14.5px/1 var(--sans); cursor: pointer; }
    .film-tabs button[aria-selected=true] { background: var(--ink); color: #fff; }
    .film-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 32px; align-items: center; padding: 28px; border-radius: 20px; }
    .fp-flow { display: grid; gap: 22px; }
    .fp-prompt { display: block; quotes: '“' '”'; font: 700 clamp(20px, 2vw, 25px)/1.3 var(--sans); letter-spacing: -.015em; }
    .fp-steps { margin: 0; padding: 0; list-style: none; counter-reset: s; }
    .fp-steps li { position: relative; padding: 7px 0 7px 32px; font-size: 15px; color: var(--ink-2); counter-increment: s; }
    .fp-steps li::before { content: counter(s); position: absolute; left: 0; top: 7px; display: grid; place-items: center; width: 21px; height: 21px; border-radius: 50%; background: var(--amber-soft); color: var(--amber-ink); font: 700 11.5px/1 var(--mono); }
    .fp-steps li:last-child::before { content: '✓'; background: var(--amber); color: var(--ink); }
    .fp-result { margin: 0; }
    .fp-result video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; background: var(--dark); }
    .fp-result.tall video { width: auto; height: min(440px, 60vh); aspect-ratio: 9 / 16; margin: 0 auto; }
    .fp-result figcaption { margin-top: 10px; text-align: center; font-size: 13px; color: var(--ink-3); }

    /* the harness, in three lines */
    .harness { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 32px; padding: 0; }
    .harness li { display: grid; gap: 4px; padding: 18px 20px; border-radius: 16px; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
    .harness b { font: 700 16.5px/1.3 var(--sans); }
    .harness span { font-size: 14.5px; color: var(--ink-2); }

    /* build with: copy beside a terminal */
    .build-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: center; }
    .build-copy { padding: clamp(22px, 3vw, 36px); border-radius: 20px; background: rgba(255, 255, 255, .88); }
    .build-copy .kicker { display: inline-block; margin: 0; background: var(--amber-soft); color: var(--amber-ink); }
    .build h2 { margin: 14px 0 0; font-size: clamp(30px, 3.6vw, 44px); }
    .build-copy > p { margin: 12px 0 0; font-size: 16.5px; color: var(--ink-2); }
    .build-list { list-style: none; margin: 18px 0 0; padding: 0; }
    .build-list li { padding: 11px 0; border-top: 1px solid var(--line-2); font-size: 15px; color: var(--ink-2); }
    .build-list b { color: var(--ink); }
    .build-list span:not(.tag) { display: block; margin-top: 2px; }
    .build-list a { color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--amber); }
    .build-list .tag { margin-left: 6px; padding: 3px 9px; font-size: 11.5px; }
    .cta-row.left { justify-content: flex-start; margin-top: 20px; }
    .term { border-radius: 18px; overflow: hidden; background: var(--dark); box-shadow: 0 40px 80px -40px rgba(20, 10, 40, .7); }
    .term-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; background: #2a2a2a; }
    .term-bar i { width: 11px; height: 11px; border-radius: 50%; background: #4a4a48; }
    .term-bar span { margin-left: 8px; font-size: 12.5px; color: #a9a8a1; }
    .term pre { margin: 0; padding: 18px 20px 22px; overflow-x: auto; font-size: 13.5px; line-height: 1.75; color: #e9e7df; }
    .term .c { color: #8d8c86; }
    .term .p { color: var(--amber); }

    .cards .band { justify-content: space-between; }
    .cards .num { padding: 5px 9px; border-radius: 999px; background: rgba(255, 255, 255, .85); }
    .cards code { font: 500 .88em var(--mono); padding: 1px 5px; border-radius: 5px; background: var(--bg-2); }

    /* coming next: cards with a strip of painting */
    .cards { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .cards li { overflow: hidden; border-radius: 18px; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
    .band { display: flex; align-items: flex-start; height: 120px; padding: 14px; }
    .cards h3, .cards p { padding: 0 22px; }
    .cards p { padding-bottom: 24px; }
    .cards h3, .first h3 { margin: 18px 0 0; font-size: 19px; letter-spacing: -.015em; }
    .cards p, .first p { margin: 8px 0 0; font-size: 15.5px; color: var(--ink-2); }
    .cards q, .first q { quotes: '“' '”'; color: var(--ink); font-weight: 650; }
    .tag { display: inline-flex; padding: 5px 11px; border-radius: 999px; background: rgba(32, 32, 32, .86); color: #fff; font: 700 12.5px/1.2 var(--sans); }
    .tag.later { background: rgba(255, 255, 255, .85); color: var(--ink-2); }

    /* install */
    .first { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .first li { padding: 24px; border-radius: 18px; }
    .num { font: 600 13px/1 var(--mono); color: var(--amber-ink); }
    .first h3 { margin-top: 14px; }
    .install { margin-top: 16px; padding: 24px; border-radius: 20px; }
    .tabs { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(38, 38, 38, .07); }
    .tabs button { height: 38px; padding: 0 18px; border: 0; border-radius: 999px; background: none; color: var(--ink-2); font: 600 14px/1 var(--sans); cursor: pointer; }
    .tabs button[aria-selected=true] { background: var(--ink); color: #fff; }
    .tabpanel { margin-top: 20px; }
    .how { margin: 0 0 12px; color: var(--ink-2); }
    .cmd { display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 20px; border-radius: 14px; background: var(--dark); color: #f4f2ec; }
    .cmd code { flex: 1; font: 500 15.5px/1.6 var(--mono); overflow-x: auto; white-space: pre; scrollbar-width: none; }
    .cmd code::before { content: '$ '; color: var(--amber); }
    .cmd.multi { align-items: flex-start; padding-block: 14px; }
    .cmd.multi code { font-size: 13px; line-height: 1.8; }
    .cmd.multi code::before { content: none; }
    .cmd.prose code { white-space: pre-wrap; font: 15px/1.6 var(--sans); color: #dedbd2; }
    .copy { flex: none; height: 38px; min-width: 76px; padding: 0 16px; border: 0; border-radius: 999px; background: rgba(255, 255, 255, .12); color: #fff; font: 600 13.5px/1 var(--sans); cursor: pointer; }
    .copy:hover { background: rgba(255, 255, 255, .2); }
    .copy.ok { background: var(--amber); color: var(--ink); }
    .alt { margin: 14px 0 0; color: var(--ink-3); font-size: 14.5px; }
    .alt a, .qs a, .credit a, .faq-side a { color: var(--ink-2); text-underline-offset: 3px; }
    .alt a:hover, .qs a:hover { color: var(--ink); }
    .windows { margin-top: 20px; }

    /* open source: painted tiles */
    .oss-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
    .oss-head h2 { margin: 0; font-size: clamp(28px, 3vw, 36px); }
    .oss-head p { margin: 6px 0 0; color: var(--ink-2); }
    .bento { margin-top: 28px; display: grid; grid-template-columns: 1.1fr 1.4fr .9fr; grid-template-rows: 220px 220px; gap: 12px; }
    .tile { display: flex; flex-direction: column; justify-content: flex-end; padding: 22px 24px; border-radius: 18px; color: #fff; text-decoration: none; }
    .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(20, 20, 10, .42)); }
    .tile .big { font: 800 clamp(34px, 4vw, 54px)/1 var(--sans); letter-spacing: -.035em; text-shadow: 0 2px 18px rgba(0, 0, 0, .25); }
    .tile .what { margin-top: 8px; font: 600 15px/1.3 var(--sans); }
    .tile .go { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, .88); color: var(--ink); font-size: 14px; transition: transform .2s; }
    .tile:hover .go { transform: translate(2px, -2px); }
    .tile::before { transition: opacity .7s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
    .tile:hover::before { transform: scale(1.05); }
    .t1 { grid-column: 1 / 3; }
    .t2 { grid-row: 1 / 3; grid-column: 3; }
    .t5 { display: none; }

    /* the cat, on his rocks */
    .cat .panel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: center; }
    .cat .panel > * { max-width: none; margin: 0; }
    .cat figure { margin: 0; }
    .cat video { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; background: var(--bg-2); box-shadow: 0 0 0 6px rgba(255, 255, 255, .55), 0 40px 80px -40px rgba(40, 25, 10, .6); }
    .cat figcaption { width: fit-content; margin-top: 14px; padding: 5px 12px; border-radius: 999px; background: rgba(255, 255, 255, .7); font-size: 13px; color: var(--ink-2); }
    .cat-copy { padding: clamp(22px, 3vw, 36px); border-radius: 20px; }
    .cat h2 { margin: 12px 0 18px; font-size: clamp(30px, 3.6vw, 44px); }
    .cat-copy p:not(.label) { margin: 0 0 14px; font-size: 17px; color: var(--ink-2); }
    .cat-copy p:last-child { margin-bottom: 0; }
    .cat .label { margin: 0; }

    /* questions, beside a painted card */
    .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; align-items: start; }
    .faq-side { position: sticky; top: 84px; display: flex; flex-direction: column; justify-content: flex-end; min-height: 300px; padding: 28px; border-radius: var(--r-lg); }
    .faq-side h2 { margin: 0; font-size: clamp(36px, 4vw, 52px); }
    .faq-side p { margin: 8px 0 0; color: var(--ink-2); }
    .qs details { border-bottom: 1px solid var(--line); }
    .qs details:first-child { border-top: 1px solid var(--line); }
    summary { list-style: none; cursor: pointer; padding: 20px 0; font: 600 17.5px/1.35 var(--sans); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); font: 500 18px/1 var(--sans); transition: transform .2s, background .2s; }
    details[open] summary::after { transform: rotate(45deg); background: var(--ink); color: #fff; box-shadow: none; }
    details p { margin: 0 0 20px; max-width: 680px; color: var(--ink-2); }

    /* the closing card */
    .cta { padding: clamp(80px, 10vw, 128px) 8px clamp(80px, 10vw, 128px); }
    .dusk { display: flex; flex-direction: column; align-items: center; text-align: center; padding: clamp(56px, 8vw, 104px) 20px; border-radius: var(--r-lg); }
    .dusk img { width: 116px; height: 116px; filter: drop-shadow(0 18px 22px rgba(60, 30, 10, .35)); } /* the PNG has the macOS icon margin; the shadow follows the tile */
    .dusk h2 { margin: 14px 0 0; font-size: clamp(36px, 5vw, 60px); letter-spacing: -.035em; }
    .dusk p { margin: 12px 0 0; font-size: 18px; color: #2f2a24; }
    .dusk .cta-row { margin-top: 28px; }

    /* the film and the motion examples open over the page */
    .film { width: min(1200px, 100vw - 32px); max-width: none; max-height: none; padding: 0; border: 0; border-radius: 16px; background: #000; color: #fff; overflow: visible; }
    .film::backdrop { background: rgba(20, 20, 18, .82); backdrop-filter: blur(4px); }
    .film video { display: block; width: 100%; height: auto; border-radius: 16px; }
    .film-close { position: absolute; right: 0; top: -50px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #fff; color: var(--ink); font-size: 24px; line-height: 1; cursor: pointer; }
    .ex { width: min(1100px, 100vw - 32px, 108vh); } /* the video ≤ 61vh tall, so it and the prompt fit the window */
    .ex video { border-radius: 16px 16px 0 0; }
    .ex-info { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 18px 22px 20px; border-radius: 0 0 16px 16px; background: var(--dark); }
    .ex-title { margin: 0; font: 800 24px/1.1 var(--sans); letter-spacing: -.02em; }
    .ex-by { margin: 8px 0 0; font-size: 13.5px; color: #b9b7af; }
    .ex-by a { color: #fff; }
    .ex .film-close { top: 10px; right: 10px; z-index: 1; background: rgba(0, 0, 0, .5); color: #fff; }
    .ex-info summary { padding: 0; font: 600 13.5px/1.4 var(--sans); color: var(--amber); }
    .ex-info summary::after { content: none; }
    .ex-info pre { margin: 10px 0 0; max-height: 22vh; overflow: auto; white-space: pre-wrap; font: 400 12.5px/1.55 var(--mono); color: #d9d7cf; }

    /* footer */
    .foot { background: var(--dark); color: #f4f3ee; padding: 64px 0 32px; }
    .foot-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; }
    .foot .brand { font-size: 22px; }
    .foot-brand p { margin: 16px 0 0; max-width: 300px; font-size: 15px; color: #a9a8a1; }
    .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .cols h3 { margin: 0 0 14px; font: 600 12.5px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: #8d8c86; }
    .cols a { display: block; padding: 5px 0; font-size: 15px; color: #f4f3ee; text-decoration: none; }
    .cols a:hover { color: var(--amber); }
    .foot-base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, .1); font-size: 13.5px; color: #8d8c86; }
    .foot-base a { color: #c9c8c1; text-underline-offset: 3px; }

    /* wide screens: the painted panels stop growing */
    @media (min-width: 1700px) { .panel, .sky, .say-card, .dusk { max-width: 1680px; margin-inline: auto; } .say.live .say-pin { justify-content: center; } }

    @media (max-width: 1100px) {
      .top nav a.more { display: none; }
      .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 980px) {
      .reels { grid-template-columns: repeat(2, 1fr); }
      .ex-info { grid-template-columns: 1fr; }
      .edl .row { grid-template-columns: 36px minmax(0, 1fr); gap: 8px 14px; padding: 20px; }
      .edl .row > :nth-child(n+3) { grid-column: 2; }
      .edl .th { display: none; }
      .view { grid-template-columns: 1fr; gap: 10px; padding: 18px 0; }
      .cat .panel { grid-template-columns: 1fr; }
      .faq { grid-template-columns: 1fr; gap: 20px; }
      .film-panel { grid-template-columns: 1fr; gap: 22px; padding: 20px; }
      .build-in { grid-template-columns: 1fr; }
      .harness { grid-template-columns: 1fr; }
      .faq-side { position: relative; top: auto; min-height: 180px; } /* not static: the painting layer is positioned against it */
      .first { grid-template-columns: 1fr; }
      .bento { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 180px; }
      .t1 { grid-column: 1 / 3; }
      .t2 { grid-row: auto; grid-column: auto; }
      .t5 { display: flex; grid-column: 1 / 3; }
      .foot-top { grid-template-columns: 1fr; }
    }
    @media (max-width: 820px) {
      .top-in { grid-template-columns: auto 1fr; padding: 0 14px; }
      .top nav { display: none; }
    }
    @media (max-width: 760px) {
      .hero, .cta, .say { padding-inline: 6px; }
      .panel { margin-inline: 6px; margin-top: 28px; }
      .sky, .say-card, .dusk, .panel { border-radius: 22px; }
      /* phones: the copy tightens so the video frame is on the first screen */
      .sky { padding-top: 22px; }
      .eyebrow { font-size: 12.5px; padding: 5px 12px; }
      h1 { margin-top: 12px; font-size: clamp(36px, 10.5vw, 44px); }
      .lede { margin-top: 10px; font-size: 15.5px; line-height: 1.45; }
      .cta-row { margin-top: 16px; gap: 8px; }
      .hero .btn { height: 44px; font-size: 14px; }
      .hero .btn.dot { padding-left: 5px; }
      .hero .btn .ic { width: 32px; height: 32px; }
      .hero .btn.light { padding: 0 14px; }
      .hero .btn.light .dur { display: none; }
      .stage { margin-top: 18px; }
      .glass { padding: 5px; border-radius: 18px; }
      .hero .brew, .gh span, .steps { display: none; }
      .gh { width: 38px; padding: 0; justify-content: center; }
      .phone-only { display: inline; }
      .say-card { min-height: 0; }
      .paper { padding: 4px 16px; }
      .cmp .row.th { display: none; }
      .cmp .row { display: block; padding: 14px 0 10px; }
      .cmp .row > span { display: grid; grid-template-columns: 118px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 5px 16px; font-size: 15px; background: none; }
      .cmp .row > span::before { content: attr(data-h); font: 600 12px/1.4 var(--sans); color: var(--ink-3); }
      .cmp .row > .us::before { color: var(--amber-ink); }
      .cmp .row > .us { background: rgba(242, 165, 65, .2); padding-block: 8px; margin-top: 4px; }
      .cmp .row > [role=rowheader] { display: block; padding: 0 16px 6px; color: var(--ink); font-weight: 700; }
      .cmp .row > [role=rowheader]::before { content: none; }
      .cards { grid-template-columns: 1fr; }
      .band { height: 96px; }
      .install { padding: 16px; }
      .tabs { display: flex; }
      .tabs button { flex: 1; padding: 0 8px; font-size: 13px; }
      .cmd code { font-size: 14px; }
      .prompt { margin-top: 14px; padding: 8px 8px 8px 14px; border-radius: 16px; }
      .prompt-text { font-size: 14.5px; min-height: 4.5em; }
      .chips { flex-wrap: nowrap; justify-content: flex-start; width: calc(100% + 24px); margin-inline: -12px; padding: 2px 12px; overflow-x: auto; scrollbar-width: none; }
      .chips::-webkit-scrollbar { display: none; }
      .chips li { flex: none; }
      .film-tabs { flex-wrap: nowrap; justify-content: flex-start; width: auto; overflow-x: auto; scrollbar-width: none; border-radius: 16px; }
      .film-tabs::-webkit-scrollbar { display: none; }
      .film-tabs button { flex: none; padding: 0 14px; font-size: 13.5px; }
      .fp-result.tall video { height: 380px; }
      .term pre { font-size: 12px; }
      .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 560px) {
      /* the motion tiles: a row you swipe, the next one peeking in, instead of three screens of stacked video */
      .reels { display: flex; gap: 12px; margin: 0 -10px; padding: 6px 10px 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 10px; scrollbar-width: none; overscroll-behavior-x: contain; }
      .reels::-webkit-scrollbar { display: none; }
      .reels li { flex: 0 0 84%; scroll-snap-align: start; }
      .js.move .reels li[data-r] { transform: none; }
      .bento { grid-template-columns: 1fr; grid-auto-rows: 160px; }
      .t1, .t5 { grid-column: auto; }
      .acts .btn { padding: 0 14px; }
    }
  </style>
</body>
</html>
