---
import '@fontsource-variable/albert-sans'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/global.css'
import Demo from '../components/Demo.astro'
import release from '../release.json'
import motion from '../data/motion.json'
import Pricing from '../components/Pricing.astro'
import { OFFERS, PRICING_FAQS, PLAN_SUMMARY, STARTER_CREDITS, fmt } from '../data/plans'

// the latest release; .github/workflows/release.yml refreshes src/release.json when Manul ships
const version = release.version
const dl = (f: string) => `https://github.com/hormuz-labs/manul/releases/download/v${version}/${f}`
const apt = `curl -fsSL https://apt.manul.si/manul.gpg | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/manul.gpg &&
echo "deb [signed-by=/usr/share/keyrings/manul.gpg] https://apt.manul.si stable main" | sudo tee /etc/apt/sources.list.d/manul.list &&
sudo apt update && sudo apt install manul`
const agentPrompt = `Install Manul from https://github.com/hormuz-labs/manul. On macOS run \`brew install hormuz-labs/tap/manul\`. On Debian or Ubuntu run:\n\n${apt}\n\nOr download the .deb or AppImage for this machine from the latest GitHub release. Then open Manul.`
const brew = 'brew install hormuz-labs/tap/manul'
const title = 'Manul: the open-source AI video agent for Mac and Linux'
const description = 'Manul is an open-source video agent you talk to. It edits your footage, makes motion graphics, voice and music, and exports the film, on your own computer with your own model keys. Free for macOS and Linux (Apache-2.0), or one Manul key paid in credits: an alternative to CapCut, Premiere Pro, Descript and HyperFrames.'
const gh = 'https://github.com/hormuz-labs/manul'
// motion examples from the gallery inside Manul: made by the people credited, with Claude; collected by prompt-motion.com.
// Videos and posters stream from Manul's bucket (scripts/publish-motion-gallery.mjs in the app's repo).
const media = 'https://storage.googleapis.com/manul-gallery/v1'
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`
// a trace under each line of the readout, drawn here so the page ships no script for it (600 × 28, seeded so it never changes)
let seed = 7
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
const W = 600, H = 28
const f1 = (n: number) => Math.round(n * 10) / 10
function wordsTrace() {
  let x = 0, out = '', i = 0
  while (x < W) {
    const um = i === 4 || i === 17, w = um ? 9 : 6 + rnd() * 22
    i++
    out += `<rect x="${f1(x)}" y="${um ? 9 : 10}" width="${f1(w)}" height="${um ? 10 : 8}" class="${um ? 'r' : 'p'}"/>`
    x += w + (rnd() < .12 ? 14 + rnd() * 16 : 3)
  }
  return out
}
const voicesTrace = () => [[0, 70, 0], [70, 190, 1], [190, 240, 0], [240, 380, 1], [380, 470, 0], [470, 530, 1], [530, 600, 0]]
  .map(([a, b, v]) => `<rect x="${a}" y="${v ? 15 : 7}" width="${b - a - 2}" height="6" class="${v ? 'q' : 'p'}"/>`).join('')
function shotsTrace() {
  const cuts = [0, 46, 118, 150, 230, 268, 342, 400, 455, 520, 600]
  let out = ''
  cuts.slice(0, -1).forEach((a, i) => {
    const b = cuts[i + 1], shaky = i === 2 || i === 6, frozen = i === 8
    if (shaky) {
      let d = `M${a + 3} 14`
      for (let x = a + 3; x < b - 3; x += 4) d += ` L${x} ${f1(14 + (rnd() - .5) * 14)}`
      out += `<path d="${d}" class="rl"/>`
    } else out += `<rect x="${a + 2}" y="${frozen ? 6 : 12}" width="${b - a - 4}" height="${frozen ? 16 : 4}" class="${frozen ? 'h' : 'p'}"/>`
    if (i) out += `<rect x="${a - 1}" y="2" width="2" height="24" class="p"/>`
  })
  return out
}
function subjectTrace() {
  let d = '', band = ''
  for (let x = 0; x <= W; x += 10) {
    const y = 14 + Math.sin(x / 70) * 7 + Math.sin(x / 23) * 2
    d += `${x ? 'L' : 'M'}${x} ${f1(y)} `
    if (x % 60 === 0) band += `<rect x="${x - 4}" y="${f1(y - 10)}" width="8" height="20" class="h"/>`
  }
  return band + `<path d="${d}" class="rl"/>`
}
function musicTrace() {
  let out = ''
  for (let i = 0, x = 4; x < W; i++, x += 9.4) {
    const bar = i % 4 === 0, drop = i === 40
    out += `<rect x="${f1(x)}" y="${drop ? 0 : bar ? 4 : 10}" width="${drop ? 3 : 1.5}" height="${drop ? 28 : bar ? 20 : 8}" class="${drop ? 'r' : 'p'}"/>`
  }
  return out
}
function soundTrace() {
  let d = 'M0 26', x = 0
  while (x < W) {
    const quiet = rnd() < .1, w = quiet ? 10 + rnd() * 18 : 4
    d += ` L${f1(x)} ${quiet ? 26 : f1(26 - 6 - rnd() * 18)}`
    x += w
  }
  return `<path d="${d} L${W} 26 Z" class="pf"/>`
}
const svg = (inner: string) => `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${inner}</svg>`
// the readout: what the agent reads about a film before it cuts (one 6-minute interview, with a song under it)
const log = [
  { k: 'Words', trace: svg(wordsTrace()), found: '2,417 words, each with its start and end; cut points moved into the quiet between them', say: 'cut the ums' },
  { k: 'Voices', trace: svg(voicesTrace()), found: 'two speakers, told apart by voice <i>A 61% · B 39%</i>', say: 'keep only Ravi’s answers' },
  { k: 'Shots', trace: svg(shotsTrace()), found: '38 shots <i>shaky at 00:52 and 02:10</i> <i>frozen 03:31–03:35</i> and the exposure and colour of each', say: 'lose the shaky bits' },
  { k: 'Subject', trace: svg(subjectTrace()), found: 'a face, followed through 37 of 38 shots, with a crop that keeps it in frame at 9:16, 1:1 and 4:5', say: 'now a vertical one for Reels' },
  { k: 'Music', trace: svg(musicTrace()), found: 'low-light.mp3 <i>92 BPM · 64 bars</i> builds at 01:08, drops at 01:24', say: 'cut to the beat after the drop' },
  { k: 'Sound', trace: svg(soundTrace()), found: '<i>−19 LUFS</i> 14 pauses over half a second, the loudest at 04:12', say: 'tighten the pauses' },
]
const faqs = [
  ...PRICING_FAQS,
  { q: 'Does my video get uploaded anywhere?', a: `No. Cutting, rendering and transcription happen on your computer. The model only receives text (your notes, the transcript) and, when it needs to look, a few still frames. That holds with your own keys and with the Manul key.` },
  { q: 'Which AI does it use?', a: `Your pick, per project. Sign in for the Manul key and choose a tier (Low, Medium, High, and on Pro or Max, Max and Ultra), or bring your own Claude, Gemini or OpenAI key, or any OpenAI- or Anthropic-compatible endpoint. Your keys stay in your system’s keychain and are used first.` },
  { q: 'Do I need to know video editing?', a: `No. If you can describe what you want to a person, you can direct Manul. If you do know editing, you’ll get there faster: it understands “J-cut”, “punch in” and “duck the music”.` },
  { q: 'Do I have to type everything into the chat?', a: `No. Draw a box on the picture, drag across the timeline, or press N at a moment, and a message box opens right there: say what should change and press Enter. It goes to Manul with what you pointed at, and shows in the conversation so you can look back over it. Light by default, with a dark theme in Settings.` },
  { q: 'Does Manul generate video?', a: `It makes motion graphics, voiceover and music today. Generated camera shots are next: b-roll on the fly, extending a frame to a new aspect ratio, and filling in a spot you box. They go only where you ask, through the video model you choose, and each one is labelled as generated. Your own footage is never swapped out.` },
  { q: 'What can’t it do yet?', a: `Generated shots, multi-camera sync, handing the cut to Premiere, Resolve or Final Cut, publishing straight to YouTube, an API and MCP server, Manul cloud for heavy renders, and Windows. All are on the <a href="${gh}/blob/main/ROADMAP.md">roadmap</a>, in the open.` },
  { q: 'How is it different from CapCut, Descript, Motion or HyperFrames?', a: `CapCut, Premiere Pro, Final Cut Pro and DaVinci Resolve hand you a timeline to operate. Descript lets you edit by editing the transcript. HyperFrames and Remotion turn video into code that an agent writes. Hosted video agents run in someone else’s cloud, on your uploads, on their credits. Manul is an open-source agent on your own computer: you give notes in plain words, point at the frame, and review each change as a before and after, with any model you like.` },
  { q: 'Who makes it?', a: `Hormuz Labs, in the open. Issues, ideas and pull requests are welcome on <a href="${gh}">GitHub</a>. For teams and business, write to <a href="mailto:hello@hormuz-labs.dev">hello@hormuz-labs.dev</a>.` },
]
// the hero's prompt box: one example per kind of film; the chips swap it
const chips = [
  { k: 'Edit footage', p: 'Cut the ums and the restarts, keep only Ravi’s answers, and put quiet music under it.' },
  { k: 'Motion design', p: 'A 20-second logo reveal for @logo.png, in our colours, on a track with a clear beat.' },
  { k: 'Clip highlights', p: 'Find the five best moments in this 40-minute podcast and make each a vertical Short with captions.' },
  { k: 'Talking head', p: 'Punch in when I make a point, put my name on screen when I introduce myself, and lose the shaky bits.' },
  { k: 'Product walkthrough', p: 'A walkthrough of app.example.com: sign up and make a first project, with a voiceover.' },
  { k: 'Article to video', p: 'Turn this blog post into a 60-second explainer with kinetic type, a voiceover and music.' },
  { k: 'Launch video', p: 'A 15-second launch film for our new feature, in the style of @reference.mp4.' },
]
// many kinds of films, one agent: what you say, what Manul does, what comes out
const ex = (id: string) => motion.find(m => m.id === id)!
const films = [
  { k: 'Edit footage', prompt: 'Make it cinematic, and put his name on screen.', steps: ['Measured the clip: one shot, one face, followed in every frame', 'Graded it and set it in a widescreen letterbox', 'Set his name in real type, in on the look', 'Rendered on your computer with ffmpeg', 'Before and after ready: keep it or send it back'], video: '/demo/cinema.mp4', poster: '/demo/cinema.webp', shape: 'wide', cap: 'The after, rendered by the same engine Manul drives' },
  { k: 'Shorts & Reels', prompt: 'Make it a Short with a caption.', steps: ['Found the subject and tracked him through the shot', 'Reframed 16:9 to 9:16 so he never leaves the frame', 'Timed the caption to the moment and burned it in', 'Exported 1080 × 1920, ready for Shorts, Reels and TikTok'], video: '/demo/short.mp4', poster: '/demo/short.webp', shape: 'tall', cap: 'The after, rendered by the same engine Manul drives' },
  { k: 'Motion design', prompt: `Use the “${ex('tdinh-me-815acb').title}” example, but reveal @logo.png in our colours.`, steps: ['Read the example’s prompt and studied the film', 'Asked for what it needed: the logo, two colours, a track', 'Showed a storyboard, one line per scene, before a frame', 'Built each scene as real motion graphics you can edit on the picture', 'Rendered 21 seconds at 1080p'], video: `/motion/tdinh-me-815acb.mp4`, poster: '/motion/tdinh-me-815acb.jpg', shape: 'wide', cap: `The example it starts from, by @${ex('tdinh-me-815acb').handle}` },
  { k: 'Launch video', prompt: 'A 15-second launch film for dub.co, like the Dub promo example. Go all out.', steps: ['Opened dub.co in its own browser for the product, colours and copy', 'Wrote the beats and a storyboard for you to approve', 'Cut every scene on the beat of the track', 'Made the voiceover and the music through your key', 'Exported 16:9 and a 9:16 cut for socials'], video: `/motion/steventey-0d20e4.mp4`, poster: '/motion/steventey-0d20e4.jpg', shape: 'wide', cap: `The example it starts from, by @${ex('steventey-0d20e4').handle}` },
]
// the line that fills in, letter by letter, as you scroll past it (split here so the page ships it ready)
const say = 'You say what you want and point at the frame. Manul watches the whole film, makes the cut on your computer, and hands it back as a before and after.'
let sayN = 0
const sayWords = say.split(' ').map(w => [...w].map(c => ({ c, i: sayN++ })))
// a painting behind a panel: the image loads when the panel comes near (see .paint in the styles)
const paint = (name: string, pos = 'center', tint = '#e9e6da') => `--img:url(/paint/${name}.webp);--pos:${pos};--tint:${tint}`
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fdfdf6" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://manul.si/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manul.si/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://manul.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/paint/steppe.webp" as="image" type="image/webp" />
  <!-- before first paint: "js" turns on the lazy paintings and reveals, "move" the scroll motion (not for reduced motion) -->
  <script is:inline>document.documentElement.classList.add('js'); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('move')</script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Manul', applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Linux', offers: OFFERS, url: 'https://manul.si/', description: PLAN_SUMMARY,
    downloadUrl: `${gh}/releases/latest`, softwareVersion: version, license: `${gh}/blob/main/LICENSE`,
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: 'Manul: you direct, it edits',
    description: 'An 88-second film about Manul, the video editor you talk to: drop in footage, say what you want, point at the frame, keep or send back each edit.',
    thumbnailUrl: 'https://manul.si/film/poster.jpg', contentUrl: 'https://manul.si/film/manul.mp4', uploadDate: '2026-10-07', duration: 'PT1M28S',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  })} />
</head>
<body>
  <header class="top" id="top">
    <div class="top-in">
      <nav aria-label="On this page">
        <a href="#films">Product</a>
        <a href="#build">Developers</a>
        <a href="#pricing">Pricing</a>
        <a href="#fits" class="more">Compare</a>
        <a href="#faq" class="more">FAQ</a>
      </nav>
      <a class="brand" href="/" aria-label="Manul home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>Manul</span></a>
      <div class="acts">
        <a class="gh" href={gh} aria-label="Manul on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
          <span>Star</span>
        </a>
        <a href="#get" class="btn sm">Download</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" aria-label="Manul">
      <div class="sky paint seen" style={paint('steppe', 'center 30%', '#bcd6ef')}>
        <div class="hero-copy">
          <a class="eyebrow" href="#get"><span class="dot-live" aria-hidden="true"></span><span>v<span data-version>{version}</span> · open source · macOS &amp; Linux</span></a>
          <h1 class="slate" aria-label="Manul, the open-source video agent.">
            <span class="w" style="--i:0" aria-hidden="true">Manul,</span> <span class="w" style="--i:1" aria-hidden="true">the</span> <span class="w ringed" style="--i:2" aria-hidden="true">open-source<svg viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M150 14C96 0 22 8 9 46c-11 34 58 50 114 47 56-3 76-26 70-52-5-20-40-31-82-28"/></svg></span> <span class="w" style="--i:3" aria-hidden="true">video</span> <span class="w" style="--i:4" aria-hidden="true">agent.</span>
          </h1>
          <p class="lede">Talk to it, and it edits your footage, makes motion graphics, voice and music, and exports the film. On your own computer, your own files, your own model keys. Free, for good.</p>
          <div class="prompt" role="group" aria-label="An example of what you can ask">
            <p class="prompt-text" id="prompt-text" aria-live="polite">{chips[0].p}</p>
            <a class="prompt-go" href="#get" aria-label="Download Manul to try this"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0-6 6m6-6 6 6"/></svg></a>
          </div>
          <ul class="chips" role="list" aria-label="Kinds of video">
            {chips.map((c, i) => <li><button type="button" data-prompt={c.p} aria-pressed={i === 0 ? 'true' : 'false'}>{c.k}</button></li>)}
          </ul>
          <div class="cta-row">
            <a href="#get" class="btn dot" data-os-cta>
              <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg></span>
              <span data-os-label>Download Manul</span>
            </a>
            <button class="btn light" type="button" data-film><i class="play" aria-hidden="true"></i>Watch the film <span class="mono dur">1:28</span></button>
          </div>
          <button class="brew mono" data-copy={brew} aria-label="Copy the Homebrew install command"><span>$ {brew}</span><em>copy</em></button>
        </div>

        <div class="stage" id="try" aria-label="Try Manul">
          <div class="glass"><Demo /></div>
          <ol class="steps" aria-hidden="true">
            <li><b>1</b>Give it a note</li>
            <li><b>2</b>Drag across the frame to compare</li>
            <li><b>3</b>Keep it, or send it back</li>
          </ol>
        </div>
      </div>
      <!-- size the editor to the window, so all of it is on the first screen -->
      <script is:inline>(() => {
        const st = document.getElementById('try'), g = st.firstElementChild
        const fit = () => {
          if (innerWidth < 900) { st.style.maxWidth = ''; return }
          let w = 1104
          for (let k = 0; k < 4; k++) {
            st.style.maxWidth = w + 'px'
            // layout sizes, not the bounding box: the editor is mid rise-in (shifted and scaled) when this first runs
            let top = 0
            for (let el = g; el; el = el.offsetParent) top += el.offsetTop
            const room = innerHeight - top - 18
            w = Math.round(Math.max(760, Math.min(1104, room * g.offsetWidth / g.offsetHeight)))
          }
          st.style.maxWidth = w + 'px'
        }
        fit(); addEventListener('resize', fit); document.fonts && document.fonts.ready.then(fit)
      })()</script>
      <p class="credit wrap">Clip: Timofey the Pallas’s cat, Moscow Zoo, CC BY 4.0. Each “after” was rendered by the same engine Manul drives. <span class="phone-only">A desktop app for macOS and Linux: open this page on your computer to install.</span></p>
    </section>

    <section class="say" id="say" aria-label={say}>
      <div class="say-pin">
        <div class="paint say-card" style={paint('mist', 'center', '#e4ebe2')}>
          <p class="kicker">From a note to a cut</p>
          <p class="say-text" aria-hidden="true">{sayWords.map(w => <><span class="sw">{w.map(ch => <span class="ch" data-i={ch.i}>{ch.c}</span>)}</span> </>)}</p>
        </div>
      </div>
    </section>

    <section class="films" id="films">
      <div class="wrap sh" data-r>
        <h2 class="slate">Many kinds of film. One agent.</h2>
        <p>Say what you want the way you’d brief an editor. Manul plans it, does the work on your computer, and hands back something you can keep or send back.</p>
      </div>
      <div class="panel paint" style={paint('dusk', 'center 40%', '#f1c79d')}>
        <div class="film-tabs" role="tablist" aria-label="Kinds of film">
          {films.map((f, i) => <button role="tab" id={`ft-${i}`} aria-controls={`fp-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ftab={i}>{f.k}</button>)}
        </div>
        {films.map((f, i) => (
          <div class="film-panel sheet" role="tabpanel" id={`fp-${i}`} aria-labelledby={`ft-${i}`} hidden={i !== 0}>
            <div class="fp-flow">
              <div class="fp-block">
                <p class="lbl">You say</p>
                <q class="fp-prompt">{f.prompt}</q>
              </div>
              <div class="fp-block">
                <p class="lbl">Manul</p>
                <ol class="fp-steps">{f.steps.map(st => <li>{st}</li>)}</ol>
              </div>
            </div>
            <figure class:list={['fp-result', f.shape]}>
              <video data-src={f.video} poster={f.poster} muted loop playsinline preload="none" aria-label={`Result: ${f.k}`}></video>
              <figcaption>{f.cap}</figcaption>
            </figure>
          </div>
        ))}
        <p class="note">Also: talking heads, tutorials, product walkthroughs filmed in your own Chrome, explainers, cleanup and repair.</p>
      </div>
    </section>

    <section class="motion" id="motion">
      <div class="wrap sh" data-r>
        <h2 class="slate">No footage? Start from these.</h2>
        <p>Pick any of 233 motion videos in Manul, each with the prompt that made it. Say what yours is about; Manul makes it the same way.</p>
      </div>
      <div class="panel paint" style={paint('bluehour', 'center', '#d9d3e6')}>
        <ul class="reels" role="list">
          {motion.map((m, i) => (
            <li data-r style={`--d:${i % 3}`}>
              <button type="button" class="reel-tile" data-ex={i} aria-label={`Play “${m.title}” by @${m.handle}`}>
                <video data-src={`/motion/${m.id}.mp4`} poster={`/motion/${m.id}.jpg`} muted loop playsinline preload="none" width="768" height="432" aria-hidden="true"></video>
                <span class="slug"><span>@{m.handle}</span><span class="mono">{clock(m.duration)}</span></span>
              </button>
            </li>
          ))}
        </ul>
        <p class="note">Made with Claude by the people credited, collected by <a href="https://prompt-motion.com">prompt-motion.com</a>. Click one for sound and the prompt.</p>
      </div>
    </section>

    <section class="notes" id="notes">
      <div class="wrap sh" data-r>
        <h2 class="slate">Say it like there’s an editor in the room.</h2>
        <p>Every word you recorded is transcribed with its timing, and every box you draw is pinned to a spot and a moment. So a note lands exactly where you meant it.</p>
      </div>
      <div class="panel paint" style={paint('peaks', 'center 70%', '#e3e6e6')}>
        <div class="edl sheet" role="table" aria-label="Notes and what Manul did with them">
          <div class="row th" role="row"><span role="columnheader">#</span><span role="columnheader">Your note</span><span role="columnheader">Where</span><span role="columnheader">What Manul did</span></div>
          <div class="row" role="row">
            <span class="n mono" role="cell">01</span>
            <q role="cell">cut <s>the ums</s>, and the bit where I lose my train of thought</q>
            <span class="at mono" role="cell">02:31 → 02:12</span>
            <span class="did" role="cell">Cut on the word, not near it. Nineteen seconds gone, no jump in the audio.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">02</span>
            <q role="cell"><i class="boxed">box</i> blur this <span class="circled">number plate</span></q>
            <span class="at mono" role="cell">00:18 · box</span>
            <span class="did" role="cell">Blurred only what’s inside your box, from 00:18 to 00:24. The rest of the shot is untouched.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">03</span>
            <q role="cell">put my name on screen when I introduce myself</q>
            <span class="at mono" role="cell">00:06 “I’m”</span>
            <span class="did" role="cell">A lower third in real type, in on the word. Drag it somewhere else after if you like.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">04</span>
            <q role="cell">quiet music under the whole thing</q>
            <span class="at mono" role="cell">00:00 → end</span>
            <span class="did" role="cell">Looped to the length of the film and dipped under every sentence. You hear the mix before anything renders.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">05</span>
            <q role="cell">now a vertical one for Shorts, captions burned in</q>
            <span class="at mono" role="cell">9:16</span>
            <span class="did" role="cell">Same film, the crop following whoever’s in frame, with captions timed to the word.</span>
          </div>
          <div class="row" role="row">
            <span class="n mono" role="cell">06</span>
            <q role="cell">put <span class="ref">@logo.png</span> bottom right, and <span class="ref">@song.mp3</span> under the intro</q>
            <span class="at mono" role="cell">your files</span>
            <span class="did" role="cell">Type @ and pick anything you dropped in, a version you kept or a title it made. The note points at it by name.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="reads" id="reads">
      <div class="wrap sh" data-r>
        <h2 class="slate">The model is your pick. The harness is the work.</h2>
        <p>Claude, Gemini and GPT all cut well once they know what’s in the film. So Manul puts its effort around the model: it measures your footage before it touches it, checks each change against the picture, and keeps every version. Swap the model per project; the harness stays.</p>
      </div>
      <ul class="harness wrap" role="list">
        <li data-r style="--d:0"><b>Measures first</b><span>Words, voices, shots, the subject, the beat, loudness. On your computer.</span></li>
        <li data-r style="--d:1"><b>Knows the craft</b><span>12 skills for talking heads, Shorts, promos, motion design, voice, music and more.</span></li>
        <li data-r style="--d:2"><b>Checks its work</b><span>Every change comes back as a before and after, never over your footage.</span></li>
      </ul>
      <div class="scrolly" style={`--n:${log.length}`}>
        <div class="pin">
          <div class="panel paint" style={paint('grass', 'center', '#d6dfcc')}>
            <div class="paper sheet">
              <div class="tracks" aria-hidden="true">
                {log.map((r, i) => <button type="button" tabindex="-1" data-step={i}><span>{r.k}</span><i></i></button>)}
              </div>
              <div class="views" role="table" aria-label="What Manul measures, and what that lets you say">
                {log.map((r, i) => (
                  <div class="view" role="row" data-i={i}>
                    <span class="k" role="rowheader">{r.k}</span>
                    <div class="found" role="cell"><p class="lbl">What it found</p><p class="mono" set:html={r.found} /><span class="trace" set:html={r.trace} /></div>
                    <div class="say-it" role="cell"><p class="lbl">So you can say</p><q>{r.say}</q></div>
                  </div>
                ))}
              </div>
            </div>
            <p class="craft">And it knows the craft of the film you’re making: talking heads, tutorials, Shorts and Reels, promos and montages, motion graphics, cleanup and repair.</p>
          </div>
        </div>
      </div>
    </section>

