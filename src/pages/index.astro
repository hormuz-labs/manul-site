    .ringed.in svg path { transition: stroke-dashoffset .9s cubic-bezier(.6,.1,.3,1) .6s; stroke-dashoffset: 0; }
    s { text-decoration: line-through transparent .1em; text-decoration-skip-ink: none; transition: text-decoration-color .5s ease .2s; }
    .in s { text-decoration-color: var(--amber); }
